@{ var authenticated = ViewData["AuthenticatedShell"] is true; var action = ViewContext.RouteData.Values["action"]?.ToString(); }
    @if (authenticated) { <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand-identity.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-refinements.css" asp-append-version="true" />
    @if (authenticated) { <link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/record-guidance.css" asp-append-version="true" /> }
    @if (!authenticated) { <link rel="stylesheet" href="~/css/public-shell.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/appearance.css" asp-append-version="true" />
    @if (!authenticated) { <link rel="stylesheet" href="~/css/public-reference.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/notes-consistency.css" asp-append-version="true" />
    @if (authenticated) { <link rel="stylesheet" href="~/css/record-details.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/workspace-readability.css" asp-append-version="true" />
    @if (authenticated && action == "Details") { <link rel="stylesheet" href="~/css/details-workspace.css" asp-append-version="true" /> }
