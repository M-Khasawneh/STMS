    <div class="dashboard-search-menu" data-work-search-menu hidden>
    <button type="button" class="dashboard-search-toggle" data-work-search-toggle aria-label="Voice and text search" title="Voice and text search" aria-expanded="false" aria-controls="dashboard-search-panel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/></svg></button>
    <section id="dashboard-search-panel" class="dashboard-search" data-dashboard-search hidden role="dialog" aria-modal="false" aria-labelledby="work-search-heading" aria-describedby="work-search-scope">
        <div class="dashboard-search-heading"><div><span class="eyebrow">WORKSPACE SEARCH</span><h2 id="work-search-heading">Search your workspace</h2><p id="work-search-scope">Find the records available to your account.</p></div><button type="button" class="dashboard-search-close" data-work-search-close aria-label="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div>
        <form asp-controller="Work" asp-action="Search" method="get" data-work-search-form>
        <div class="dashboard-search-controls">
