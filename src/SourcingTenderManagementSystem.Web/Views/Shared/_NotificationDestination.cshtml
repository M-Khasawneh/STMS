@model SourcingTenderManagementSystem.Web.Models.Entities.Notification
@if (User.IsInRole("Admin") && Model.Subject.StartsWith("Website message: ") && Model.BidId is null && Model.TenderId is null && Model.PurchaseRequisitionId is null) {
    <form asp-controller="Messages" asp-action="Open" asp-route-id="@Model.Id" method="post"><button type="submit" class="notification-open">Read message <span aria-hidden="true">↗</span></button></form>
} else if (Model.BidId.HasValue) {
    var destination = User.IsInRole("Supplier") ? "Bids" : Model.Subject is "Clarification requested" or "Clarification answered" ? "Compliance" : "ReviewBids";
    <a asp-controller="@destination" asp-action="Details" asp-route-id="@Model.BidId" class="notification-open">View offer ↗</a>
} else if (Model.TenderId.HasValue && Model.Subject is "Unified report submitted" or "Manager report decision") {
    <a asp-controller="UnifiedReports" asp-action="Details" asp-route-id="@Model.TenderId" class="notification-open">View unified report ↗</a>
} else if (Model.TenderId.HasValue && Model.Subject == "Evaluation started") {
    <a asp-controller="ReviewBids" asp-action="Index" asp-route-tenderId="@Model.TenderId" class="notification-open">View offers to evaluate ↗</a>
} else if (Model.TenderId.HasValue) {
    <a asp-controller="Tenders" asp-action="Details" asp-route-id="@Model.TenderId" class="notification-open">View tender ↗</a>
} else if (Model.PurchaseRequisitionId.HasValue) {
    <a asp-controller="Requisitions" asp-action="Details" asp-route-id="@Model.PurchaseRequisitionId" class="notification-open">View requisition ↗</a>
}
