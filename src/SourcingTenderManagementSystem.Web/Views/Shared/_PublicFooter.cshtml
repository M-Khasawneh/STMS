@* Native implementation of the publicly demonstrated efferd Sticky Footer behavior.
   Reference inspected through 21st MCP: https://21st.dev/@efferd/components/sticky-footer.
   No React/Motion source or proprietary assets are embedded. *@
@{ var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index"; }
<footer class="public-footer sticky-public-footer" aria-label="Sourcing & Tender Management System footer" data-sticky-footer data-footer-sticky-enabled="@(isHome ? "true" : "false")">
    <div class="sticky-footer-surface">
        <div class="sticky-footer-light" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="sticky-footer-body">
            <div class="sticky-footer-columns">
                <div class="sticky-footer-intro" data-footer-reveal><a asp-controller="Home" asp-action="Index" class="sticky-footer-brand"><img src="~/images/brand/stms-logo.png" asp-append-version="true" width="44" height="44" alt="" /><span>Sourcing &amp; Tender<br /><small>Management System</small></span></a><p>One connected platform for purchase requests, supplier offers and informed sourcing decisions.</p><a asp-controller="Home" asp-action="Contact" class="sticky-footer-contact">Contact administration <span aria-hidden="true"><partial name="_LinkArrow" /></span></a></div>
                <nav aria-label="Footer platform navigation" data-footer-reveal><h2>Platform</h2><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Home" asp-action="About">About the platform</a><a asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">How It Works</a><a asp-controller="Home" asp-action="Contact">Contact</a></nav>
                <nav aria-label="Footer account navigation" data-footer-reveal><h2>Account access</h2><a asp-controller="Account" asp-action="Login">Account login</a><a asp-controller="Suppliers" asp-action="Register">Supplier Registration</a><p>Supplier access begins after administrator approval.</p></nav>
                <div class="sticky-footer-connection" data-footer-reveal><h2>Let’s connect</h2><p>Questions about the platform or getting started?</p><a asp-controller="Home" asp-action="Contact" class="sticky-footer-action" aria-label="Send a message to the administrator"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v12H4ZM4 7l8 6 8-6" /></svg><span>Send a message</span><span aria-hidden="true"><partial name="_LinkArrow" /></span></a></div>
            </div>
            <div class="sticky-footer-bottom"><span>&copy; @DateTime.UtcNow.Year Sourcing &amp; Tender Management System</span><div>@if (isHome) { <a asp-controller="Home" asp-action="Privacy">Privacy</a> }<a href="#main-content">Back to top <span aria-hidden="true">↑</span></a></div></div>
        </div>
    </div>
</footer>
