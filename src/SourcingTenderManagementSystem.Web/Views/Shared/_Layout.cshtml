@using SourcingTenderManagementSystem.Web.Data
@inject IServiceProvider Services
@using SourcingTenderManagementSystem.Web.Security
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var admin = User.IsInRole(ApplicationRoles.Admin);
    var publicWebsite = ViewData["PublicHome"] is true || ViewData["PublicWebsite"] is true;
    var authenticated = signedIn && !publicWebsite;
    var adminDashboard = admin && ViewData["AdminDashboard"] is true;
    var adminWorkspace = authenticated && admin && !publicWebsite;
    var presentation = Services.GetService<IWorkspacePresentation>();
    var inbox = authenticated ? Services.GetService<NotificationInbox>() : null;
    var notificationMenu = inbox is not null ? (await inbox.MenuAsync(User)) with { ReturnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString } : null;
    long? unread = notificationMenu?.Unread ?? (authenticated && inbox is null && presentation is not null ? await presentation.UnreadAsync(User) : null);
    var hasPicture = authenticated && presentation?.HasAvatar(User) == true;
    var roleName = admin ? "Administrator" : string.Join(" · ", new[] {
        (ApplicationRoles.Supplier, "Supplier"), (ApplicationRoles.RequestingDepartment, "Requesting department"),
        (ApplicationRoles.SourcingOfficer, "Sourcing officer"), (ApplicationRoles.SourcingManager, "Sourcing manager"),
        (ApplicationRoles.EvaluationCommittee, "Evaluation committee"), (ApplicationRoles.TopCommittee, "Top committee")
    }.Where(role => User.IsInRole(role.Item1)).Select(role => role.Item2));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B1220" />
    <title>@ViewData["Title"] &middot; Sourcing &amp; Tender</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (authenticated) { <link rel="stylesheet" href="~/css/workspace-ui.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/work-hub.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/dashboard-search.css" asp-append-version="true" /> }
    @await RenderSectionAsync("Styles", required: false)
    @if (authenticated) { <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand-identity.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-refinements.css" asp-append-version="true" />
    @if (authenticated) { <link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true" /> }
    @if (!authenticated) { <link rel="stylesheet" href="~/css/public-shell.css" asp-append-version="true" /> }
</head>
<body class="@(ViewData["PremiumLanding"] is true ? "premium-landing" : "") @(authenticated ? "workspace workspace-theme" : "public-shell") @(publicWebsite ? "stms-home" : "") @(controller == "Account" && action == "Login" ? "account-login-page" : "") @(adminWorkspace ? "admin-workspace" : "") @(adminDashboard ? "admin-dashboard-page" : "")" data-workspace-controller="@controller" data-workspace-action="@action">
    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (authenticated)
    {
        <aside class="sidebar" id="workspace-navigation" aria-label="Workspace navigation">
            <a class="brand" asp-controller="Workspace" asp-action="Index"><span class="brand-mark brand-logo"><img src="~/images/brand/stms-logo.png" asp-append-version="true" alt="" width="52" height="52" /></span><span>Sourcing<span class="brand-sub">&amp; Tender</span></span></a>
            <div class="nav-label">WORKSPACE</div>
            <nav class="side-links" aria-label="Main navigation">
                <a class="side-link @(controller == "Workspace" ? "active" : "")" aria-current="@(controller == "Workspace" ? "page" : null)" asp-controller="Workspace" asp-action="Index"><svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10 12 3l9 7v11h-6v-7H9v7H3Z"/></svg>Dashboard</a>
                <a class="side-link @(controller == "Work" && action == "Tasks" ? "active" : "")" aria-current="@(controller == "Work" && action == "Tasks" ? "page" : null)" asp-controller="Work" asp-action="Tasks"><span class="nav-icon" aria-hidden="true">&#9745;</span>My tasks</a>
                @if (admin)
                {
                    <div class="nav-label">ADMINISTRATION</div>
                    <a class="side-link @(controller == "Work" && action == "Audit" ? "active" : "")" aria-current="@(controller == "Work" && action == "Audit" ? "page" : null)" asp-controller="Work" asp-action="Audit"><span class="nav-icon" aria-hidden="true">&#9636;</span>Audit trail</a>
                    <a class="side-link @(controller == "Messages" ? "active" : "")" aria-current="@(controller == "Messages" ? "page" : null)" asp-controller="Messages" asp-action="Index"><svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Messages</a>
                    <a class="side-link @(controller == "Departments" ? "active" : "")" aria-current="@(controller == "Departments" ? "page" : null)" asp-controller="Departments" asp-action="Index"><svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 7h1m4 0h1M9 11h1m4 0h1M10 21v-6h4v6"/></svg>Departments</a>
                    <a class="side-link @(controller == "Employees" ? "active" : "")" aria-current="@(controller == "Employees" ? "page" : null)" asp-controller="Employees" asp-action="Index"><svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6m2 4a5 5 0 0 1 3 5"/></svg>Employees</a>
                }
                @if (admin) { <a class="side-link @(controller == "Suppliers" ? "active" : "")" aria-current="@(controller == "Suppliers" ? "page" : null)" asp-controller="Suppliers" asp-action="Index"><span class="nav-icon" aria-hidden="true">&#9671;</span>Suppliers</a> }
                @if (User.IsInRole(ApplicationRoles.Supplier)) { <a class="side-link @(controller == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Status">My company</a> }
                @if (admin || User.IsInRole(ApplicationRoles.RequestingDepartment) || User.IsInRole(ApplicationRoles.SourcingOfficer)) {
                    <a class="side-link @(controller == "Requisitions" ? "active" : "")" aria-current="@(controller == "Requisitions" ? "page" : null)" asp-controller="Requisitions" asp-action="Index"><span class="nav-icon" aria-hidden="true">&#9636;</span>Requisitions</a>
                }
                @if(admin||User.IsInRole(ApplicationRoles.SourcingOfficer)||User.IsInRole(ApplicationRoles.SourcingManager)||User.IsInRole(ApplicationRoles.RequestingDepartment)||User.IsInRole(ApplicationRoles.Supplier)) { <a class="side-link @(controller=="Tenders" && action!="Inbox" && action!="Invitation"?"active":"")" aria-current="@(controller=="Tenders" && action!="Inbox" && action!="Invitation"?"page":null)" asp-controller="Tenders" asp-action="Index">@if(authenticated){<svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21h16M6 17V6l6-3 6 3v11M9 9h6m-6 4h6m-3 4v4"/></svg>}Tenders</a> }
                @if(User.IsInRole(ApplicationRoles.Supplier)){<a class="side-link @((controller=="SupplierPortal" || controller=="Tenders" && (action=="Inbox" || action=="Invitation"))?"active":"")" aria-current="@((controller=="SupplierPortal" || controller=="Tenders" && (action=="Inbox" || action=="Invitation"))?"page":null)" asp-controller="Tenders" asp-action="Inbox">My invitations</a>}
                @if(User.IsInRole(ApplicationRoles.Supplier)){<a class="side-link @((controller == "Bids" || controller == "Compliance")?"active":"")" aria-current="@((controller == "Bids" || controller == "Compliance")?"page":null)" asp-controller="Bids" asp-action="Index">My Offers</a>}
                @if (!admin && !User.IsInRole(ApplicationRoles.Supplier) && (User.IsInRole(ApplicationRoles.SourcingOfficer) || User.IsInRole(ApplicationRoles.SourcingManager) || User.IsInRole(ApplicationRoles.EvaluationCommittee) || User.IsInRole(ApplicationRoles.TopCommittee))) {
                    <a class="side-link @((controller == "ReviewBids" || controller == "Compliance" || controller == "Evaluations" || controller == "UnifiedReports") ? "active" : "")" aria-current="@((controller == "ReviewBids" || controller == "Compliance" || controller == "Evaluations" || controller == "UnifiedReports") ? "page" : null)" asp-controller="ReviewBids" asp-action="Index">Submitted offers</a>
                }
                @if (!admin && !User.IsInRole(ApplicationRoles.Supplier) && (User.IsInRole(ApplicationRoles.SourcingOfficer) || User.IsInRole(ApplicationRoles.SourcingManager) || User.IsInRole(ApplicationRoles.TopCommittee))) {
                    <a class="side-link @(controller == "TopCommittee" ? "active" : "")" aria-current="@(controller == "TopCommittee" ? "page" : null)" asp-controller="TopCommittee" asp-action="Index">Final decisions</a>
                }
                @if (!admin && !User.IsInRole("Supplier") && (User.IsInRole("RequestingDepartment") || User.IsInRole("SourcingOfficer") || User.IsInRole("SourcingManager") || User.IsInRole(ApplicationRoles.EvaluationCommittee) || User.IsInRole("TopCommittee"))) {
                    <a class="side-link @(controller == "Clarifications" ? "active" : "")" aria-current="@(controller == "Clarifications" ? "page" : null)" asp-controller="Clarifications" asp-action="Index"><span class="nav-icon" aria-hidden="true">&#8644;</span>Clarifications</a>
                }
                <a class="side-link @(controller == "Reports" ? "active" : "")" aria-current="@(controller == "Reports" ? "page" : null)" asp-controller="Reports" asp-action="Index"><span class="nav-icon" aria-hidden="true">&#9637;</span>Reports &amp; insights</a>
            </nav>
            <div class="sidebar-bottom">
                <a class="side-link @(controller == "Profile" ? "active" : "")" aria-current="@(controller == "Profile" ? "page" : null)" asp-controller="Profile" asp-action="Index"><svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>Profile settings</a>
                <div class="account-block"><span class="avatar" aria-hidden="true">@if (hasPicture) { <img class="profile-picture" src="@Url.Action("Avatar", "Profile")" alt="" /> }@(string.IsNullOrEmpty(User.Identity?.Name) ? "U" : User.Identity.Name.Substring(0, 1).ToUpperInvariant())</span><span class="account-name">@User.Identity?.Name<small>@roleName</small></span></div>
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="logout-button">Log out <span aria-hidden="true">&#8599;</span></button></form>
            </div>
        </aside>
        <button class="sidebar-scrim" type="button" aria-label="Close navigation" tabindex="-1" hidden></button>
    }
    <div class="app-frame">
        <header class="topbar @(!authenticated ? "public-topbar" : "")">
            @if (authenticated)
            {
                <button class="menu-toggle" type="button" aria-controls="workspace-navigation" aria-expanded="false" aria-label="Open navigation" hidden><span aria-hidden="true">&#9776;</span></button>
                <div class="topbar-context">Workspace <span aria-hidden="true">/</span> <strong>@(adminDashboard ? "Administration" : controller == "Home" ? ViewData["Title"] : controller)</strong></div>
                <a class="workspace-search-link" asp-controller="Work" asp-action="Search" aria-label="Search your workspace">&#8981; <span>Search</span></a>
                <partial name="_WorkspaceSearch" />
                <details class="notification-dropdown" data-menu-url="@Url.Action("Menu", "Notifications")" data-watch-url="@Url.Action("Watch", "Notifications")">
                    <summary class="workspace-notification-bell" aria-label="@(unread > 0 ? $"Notifications, {unread} unread" : "Notifications")" title="Notifications"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span class="notification-count" hidden="@(!(unread > 0))">@(unread > 99 ? "99+" : unread.ToString())</span></summary>
                    <div class="notification-popover" role="region" aria-labelledby="notification-menu-title"><partial name="_NotificationMenu" model="@(notificationMenu ?? new SourcingTenderManagementSystem.Web.Models.NotificationMenu([], unread, false))" /></div>
                </details>
                <a class="admin-header-identity workspace-profile-link" asp-controller="Profile" asp-action="Index" aria-label="Profile settings"><span aria-hidden="true">@if (hasPicture) { <img class="profile-picture" src="@Url.Action("Avatar", "Profile")" alt="" /> }@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")</span><div><strong>@User.Identity?.Name</strong><small>@roleName</small></div></a>
                <span class="workspace-tag"><i aria-hidden="true"></i> @(admin ? "Administration" : User.IsInRole(ApplicationRoles.Supplier) ? "Supplier workspace" : "Employee workspace")</span>
            }
            else
            {
                <partial name="_PublicNavigation" />
            }
        </header>
        <main id="main-content" class="content-area" tabindex="-1">
            @if (controller is "Departments" or "Employees" or "Requisitions" or "Tenders" or "Messages" or "Clarifications" or "Reports")
            {
                <nav class="breadcrumb-line" aria-label="Breadcrumb"><a asp-controller="Workspace" asp-action="Index">Workspace</a><span aria-hidden="true">/</span>@if (action != "Index") { <a asp-controller="@controller" asp-action="Index">@controller</a><span aria-hidden="true">/</span> }<span aria-current="page">@(action == "Index" ? controller : ViewData["Title"])</span></nav>
            }
            @if (TempData["UiFeedback"] is string feedback) { <div class="alert alert-success" role="status">@feedback</div> }
            @RenderBody()
        </main>
        @if (!authenticated) { <partial name="_PublicFooter" /> }
        else {
            <footer class="app-footer"><span>&copy; @DateTime.UtcNow.Year Sourcing &amp; Tender</span><span class="footer-note">A considered workspace.</span></footer>
        }
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/workspace-refinements.js" asp-append-version="true"></script>
    @if (!authenticated) { <script src="~/js/home.js" asp-append-version="true"></script><script src="~/js/public-shell.js" asp-append-version="true"></script><script src="~/js/sticky-footer.js" asp-append-version="true"></script> }
    @await RenderSectionAsync("Scripts", required: false)
    @if (authenticated) { <script src="~/js/workspace-ui.js" asp-append-version="true"></script> }
    @if (authenticated) { <script src="~/js/experience.js" asp-append-version="true"></script><script src="~/js/notification-inbox.js" asp-append-version="true"></script> }
    @if (authenticated) { <script src="~/js/workspace-tables.js" asp-append-version="true"></script><script src="~/js/dashboard-search.js" asp-append-version="true"></script> }
</body>
</html>
