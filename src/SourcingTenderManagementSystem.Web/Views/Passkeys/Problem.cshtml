@model string
@{ViewData["Title"]="Passkey request";}
<div class="page-heading"><div><span class="eyebrow">ACCOUNT SECURITY</span><h1>Passkey request incomplete</h1></div></div><div class="alert alert-warning" role="alert">@Model</div><div class="d-flex gap-3 flex-wrap">@if(User.Identity?.IsAuthenticated==true){<a asp-action="Index" class="btn btn-outline-secondary">Manage passkeys</a>}else{<a asp-controller="Account" asp-action="Login" class="btn btn-primary">Return to login</a>}</div>
