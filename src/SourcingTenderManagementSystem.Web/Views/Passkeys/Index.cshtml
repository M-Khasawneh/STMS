@model SourcingTenderManagementSystem.Web.Models.Account.PasskeyPage
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ViewData["Title"]="Passkeys";}
@section Styles{<link rel="stylesheet" href="~/css/passkeys.css" asp-append-version="true"/>}
<div class="profile-settings"><header class="page-heading"><div><span class="eyebrow">ACCOUNT / DEVICE SIGN-IN</span><h1>Face, fingerprint &amp; PIN</h1><p>Manage your Sourcing & Tender Management System passkeys.</p></div><a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Profile settings</a></header>
@if(TempData["PasskeyStatus"] is string message){<div class="alert alert-success" role="status">@message</div>}
<section class="form-panel"><h2>Sign in with your device</h2><p>Windows Hello, Face ID, Touch ID or another compatible authenticator can verify you using face, fingerprint or PIN. The available choices depend on your device. Sourcing & Tender Management System stores the public credential, never your face images or fingerprint. Your password remains available.</p><p>Register only on a device or passkey provider you trust. Sourcing & Tender Management System cannot tell which face, fingerprint or PIN method your device used.</p>
<p><strong>On iPhone:</strong> open this page in Safari, enter a device name and your current Sourcing & Tender Management System password, then choose Register a passkey and complete the device prompt. Registration is complete only when the success message appears and your passkey is listed below. A passkey registered on a different Sourcing & Tender Management System address must be registered again here.</p>
<form asp-action="EnrollOptions" method="post" data-passkey-enroll data-finish="@Url.Action("Enroll")" data-cancel="@Url.Action("Cancel")"><label for="passkey-name" class="form-label">Passkey name</label><input id="passkey-name" name="Name" class="form-control" maxlength="80" required autocomplete="off" placeholder="e.g. My iPhone or laptop"/><label for="passkey-password" class="form-label mt-3">Current password</label><input id="passkey-password" name="CurrentPassword" type="password" class="form-control" required maxlength="256" autocomplete="current-password"/><button class="btn btn-primary mt-3" type="submit" data-passkey-button disabled>Register a passkey</button><button class="btn btn-outline-secondary mt-3" type="button" data-passkey-cancel hidden>Cancel</button><p class="form-text mt-3" role="status" aria-live="polite" data-passkey-status>Checking browser support. Password sign-in is always available.</p></form><noscript><p>JavaScript is required to register or use passkeys. Your password still works.</p></noscript></section>
<section class="form-panel"><h2>Your registered passkeys <span class="status-pill">@Model.Keys.Count / 5</span></h2>@if(Model.Keys.Count==0){<p>No passkey is registered. Use the form above after verifying your password.</p>}
@foreach(var key in Model.Keys){<article class="passkey-record"><div><h3>@key.Name</h3><p>Registered @TenderTime.Display(key.CreatedAt)</p></div><form asp-action="Remove" method="post"><input type="hidden" name="CredentialId" value="@key.CredentialId"/><label class="form-label">Current password to remove <span class="visually-hidden">@key.Name</span><input type="password" name="CurrentPassword" class="form-control" required maxlength="256" autocomplete="current-password"/></label><button type="submit" class="btn btn-outline-secondary">Remove passkey</button></form></article>}
</section></div>
@section Scripts{<script src="~/js/passkeys.js" asp-append-version="true"></script>}
