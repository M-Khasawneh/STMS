@model SourcingTenderManagementSystem.Web.Models.Account.LoginViewModel
@inject Microsoft.Extensions.Options.IOptions<SourcingTenderManagementSystem.Web.Security.FaceOptions> CameraOptions
@{ ViewData["Title"] = "Account login"; }
<div class="login-composition"><aside class="login-brand-panel" aria-labelledby="login-brand-title"><span class="login-brand-wordmark">Sourcing &amp; Tender<span>MANAGEMENT SYSTEM</span></span><div><span class="eyebrow">ONE CONNECTED WORKSPACE</span><h2 id="login-brand-title">Clear decisions.<br /><span>Confident sourcing.</span></h2><p>From purchase requests to tender decisions, bring your work into one structured process.</p><ul><li><span aria-hidden="true">01</span>Workspaces tailored to your role</li><li><span aria-hidden="true">02</span>Private supplier offers and documents</li><li><span aria-hidden="true">03</span>Traceable reviews and decisions</li></ul></div><span class="login-brand-footnote">Sourcing &amp; Tender Management System</span></aside><div class="login-form-wrap">
    <section class="login-panel" aria-labelledby="login-title">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary login-home-link"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg>Back to home</a>
        <div class="login-access-label"><span aria-hidden="true"></span> YOUR WORKSPACE</div><h1 id="login-title">Welcome back.</h1>
        <p>Sign in to continue where you left off. Employees and approved suppliers can access their workspace below.</p>
        <form asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="password-control"><input asp-for="Password" class="form-control" autocomplete="current-password" value="" /><button type="button" class="password-toggle" aria-controls="Password" aria-pressed="false" hidden>Show</button></div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Log in to your workspace <span aria-hidden="true"><partial name="_LinkArrow" /></span></button>
        </form>
        <section class="passkey-login login-alternatives" aria-label="Other sign-in methods">
            <span class="eyebrow">OTHER WAYS TO SIGN IN</span>
            <div class="login-method-grid @(CameraOptions.Value.Enabled ? "has-camera" : "")">
            @if (CameraOptions.Value.Enabled) {
            <div class="face-settings" data-face-login data-begin="@Url.Action("Begin", "CameraLogin")" data-complete="@Url.Action("Complete", "CameraLogin")" data-library="@Url.Content("~/lib/face-api/face-api.js")" data-models="@Url.Content("~/lib/face-api/model")">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-outline-secondary login-method-button" data-face-action="login" aria-label="Sign in with camera"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 5l1.5-2h5L16 5h3a2 2 0 012 2v12H3V7a2 2 0 012-2z"/><circle cx="12" cy="12" r="3.5"/></svg>Camera</button><button type="button" class="btn btn-outline-secondary" data-face-cancel hidden>Cancel camera</button>
                <div class="face-capture" data-face-preview hidden><video muted autoplay playsinline aria-label="Live camera preview"></video><span>Keep one face in the frame.</span></div>
                <p role="status" aria-live="polite" data-face-status hidden>Camera is off. Your browser will ask for permission.</p>
            </div>
            }
            <form asp-controller="Passkeys" asp-action="LoginOptions" method="post" data-passkey-login data-finish="@Url.Action("Login","Passkeys")" data-cancel="@Url.Action("Cancel","Passkeys")">
                <button class="btn btn-outline-secondary login-method-button" type="submit" data-passkey-button aria-label="Sign in with passkey" disabled><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="9" r="5"/><path d="M12 12l8 8 2-2-2-2 1-1-3-3-1 1-2-2"/></svg>Passkey</button><button type="button" class="btn btn-outline-secondary" data-passkey-cancel hidden>Cancel</button><p role="status" aria-live="polite" data-passkey-status hidden>Use a previously registered passkey. Device support determines the available verification methods.</p>
            </form>
            </div>
            <p class="login-method-help">@if (CameraOptions.Value.Enabled) { <text>Camera uses your username and must be enabled in your settings. </text> }Passkey uses your device's face, fingerprint or PIN.</p>
            <noscript><p>These methods require JavaScript. Use the password form above.</p></noscript>
        </section>
        <div class="login-supplier-callout"><span>NEW HERE?</span><h2>Register your company.</h2><p>Suppliers can apply for an account and submit official company documents.</p><a asp-controller="Suppliers" asp-action="Register" class="login-registration-button">Supplier Registration <span aria-hidden="true"><partial name="_LinkArrow" /></span></a></div>
    </section>
</div></div>
@section Styles {<link rel="stylesheet" href="~/css/passkeys.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/face-settings.css" asp-append-version="true"/>}
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/passkeys.js" asp-append-version="true"></script><script src="~/js/face-settings.js" asp-append-version="true"></script> }
