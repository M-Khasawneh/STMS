@model RoleDashboardModel
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{
    ViewData["Title"] = "My dashboard";
    var updates = Model.Sections.Where(x => x.Title == "My notifications").ToArray();
    var work = Model.Sections.Where(x => x.Title != "My notifications").ToArray();
}
@section Styles { <link rel="stylesheet" href="~/css/role-dashboard.css" asp-append-version="true" /> }
<div class="role-dashboard @(updates.Length > 0 ? "has-updates" : "")" data-role-dashboard>
    <header class="role-dashboard-header">
        <div><span class="eyebrow">YOUR WORKSPACE</span><h1>My dashboard</h1><p>Welcome, @User.Identity?.Name. Here is your current work at a glance.</p></div>
        <a asp-controller="Work" asp-action="Tasks" class="btn btn-primary">My tasks <span aria-hidden="true">&#8594;</span></a>
    </header>
    @if (!Model.Available) { <div class="alert alert-warning" role="alert">Dashboard data is temporarily unavailable. Your existing navigation and workspace search remain available.</div> }
    <div class="role-overview-grid">
        <div class="role-primary-panels">
        @foreach (var panel in work) {
            <section class="role-work-panel">
                <header class="role-panel-heading"><h2>@panel.Title</h2><span class="role-panel-label">Overview</span></header>
                <p class="role-panel-description">@panel.Description</p>
                <div class="role-summary-metrics">@foreach (var metric in panel.Metrics) {
                    <article><span>@metric.Label</span><strong>@metric.Count.ToString("N0")</strong>@if (metric.Controller is not null) { <a asp-controller="@metric.Controller" asp-action="@metric.Action">View records <span aria-hidden="true">&#8599;</span></a> }</article>
                }</div>
                <div class="role-record-heading"><h3>Recent records</h3><span>Recorded / deadline</span></div>
                @if (panel.Records.Count == 0) { <p class="role-work-empty">No records available in this section.</p> }
                else { <ul class="role-record-list">@foreach (var row in panel.Records) {
                    <li data-work-record data-work-section="@panel.Title"><div class="role-record-content">
                        @if (row.Controller is not null) { <a asp-controller="@row.Controller" asp-action="@row.Action" asp-route-id="@(row.Action == "Index" ? (Guid?)null : row.Id)">@row.Title</a> } else { <strong>@row.Title</strong> }
                        <small>@if (row.At.HasValue) { <time datetime="@row.At.Value.ToString("O")">@TenderTime.Display(row.At.Value)</time> } else { <span>No date recorded</span> }</small>
                    </div><span class="status-pill">@row.Status</span></li>
                }</ul> }
            </section>
        }
        </div>
        @if (updates.Length > 0) { <aside class="role-updates" aria-label="Your notification summary">
            @foreach (var panel in updates) {
                <section class="role-work-panel">
                    <header class="role-panel-heading"><h2>@panel.Title</h2><span class="role-panel-label">Personal</span></header>
                    <p class="role-panel-description">@panel.Description</p>
                    <div class="role-summary-metrics">@foreach (var metric in panel.Metrics) { <article><span>@metric.Label</span><strong>@metric.Count.ToString("N0")</strong>@if (metric.Controller is not null) { <a asp-controller="@metric.Controller" asp-action="@metric.Action">View notifications <span aria-hidden="true">&#8599;</span></a> }</article> }</div>
                    @if (panel.Records.Count == 0) { <p class="role-work-empty">No notifications to display.</p> }
                    else { <ul class="role-record-list">@foreach (var row in panel.Records) { <li><div class="role-record-content">@if (row.Controller is not null) { <a asp-controller="@row.Controller" asp-action="@row.Action" asp-route-id="@(row.Action == "Index" ? (Guid?)null : row.Id)">@row.Title</a> } else { <strong>@row.Title</strong> }<small>@if (row.At.HasValue) { <time datetime="@row.At.Value.ToString("O")">@TenderTime.Display(row.At.Value)</time> }</small></div><span class="status-pill">@row.Status</span></li> }</ul> }
                </section>
            }
        </aside> }
    </div>
</div>
