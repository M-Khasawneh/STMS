@model IReadOnlyList<SourcingTenderManagementSystem.Web.Models.Entities.Notification>
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ ViewData["Title"] = "Notifications"; }
<div class="eyebrow">YOUR WORKSPACE</div><h1>Notifications</h1>
@if (Model.Count == 0) { <p>No notifications found.</p> }
<ol class="requisition-history">
@foreach (var item in Model) {
    <li>
        <strong>@item.Subject</strong><small>@TenderTime.Display(item.CreatedAt)</small><p>@item.Message</p>
        @if (item.BidId.HasValue) {
            var destination = User.IsInRole("Supplier") ? "Bids" : "ReviewBids";
            if (item.Subject is "Clarification requested" or "Clarification answered") { destination = "Compliance"; }
            <a asp-controller="@destination" asp-action="Details" asp-route-id="@item.BidId" class="table-action">View offer</a>
        } else if (item.TenderId.HasValue && item.Subject == "Evaluation started") {
            <a asp-controller="ReviewBids" asp-action="Index" asp-route-tenderId="@item.TenderId" class="table-action">View offers to evaluate</a>
        } else if (item.TenderId.HasValue) {
            <a asp-controller="Tenders" asp-action="Details" asp-route-id="@item.TenderId" class="table-action">View tender</a>
        }
    </li>
}
</ol>
