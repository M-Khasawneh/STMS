@model SourcingTenderManagementSystem.Web.Models.NotificationPage
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ ViewData["Title"] = "Notifications"; }
<header class="page-heading"><div><div class="eyebrow">YOUR WORKSPACE</div><h1>Notifications</h1><p>@Model.Unread unread · @Model.Total total</p></div></header>
@if (Model.Items.Count == 0) { <p>No notifications found on this page.</p> }
<ol class="notification-page-list">
@foreach (var item in Model.Items) {
    <li class="notification-card @(item.ReadAt is null ? "is-unread" : "is-read")">
        <div class="notification-card-heading"><strong>@item.Subject</strong><span class="notification-read-state">@(item.ReadAt is null ? "Unread" : "Read")</span></div><small>@TenderTime.Display(item.CreatedAt)</small><p class="notification-message">@item.Message</p>
        <div class="notification-card-actions"><partial name="_NotificationDestination" model="item" />
        @if (item.ReadAt is null) { <form asp-action="Read" asp-route-id="@item.Id" method="post"><input type="hidden" name="returnUrl" value="@Url.Action("Index", new { page = Model.Page })" /><button type="submit">Mark as read</button></form> }
        </div>
    </li>
}
</ol>
<nav class="inbox-pagination" aria-label="Notification pages">@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)">← Previous</a> }<span>Page @Model.Page</span>@if (Model.HasNext) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)">Next →</a> }</nav>
