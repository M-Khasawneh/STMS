@model IReadOnlyList<SourcingTenderManagementSystem.Web.Models.Entities.SupplierProfile>
@{ ViewData["Title"] = "Supplier applications"; var totalCount = (ViewData["Pagination"] as SourcingTenderManagementSystem.Web.Models.PageInfo)?.Total ?? Model.Count; }
<div class="page-heading"><div><div class="eyebrow">SUPPLIER REVIEW</div><h1>Supplier applications</h1><p>Review company information and official documents before approving account access.</p></div><div class="record-count"><span data-count="@totalCount">@totalCount</span><small>applications</small></div></div>
@if (Model.Count == 0) { <section class="workspace-empty-state"><h2>No applications to display</h2><p>No supplier applications found.</p></section> }
else {
<div class="table-responsive" role="region" aria-label="Supplier applications" tabindex="0"><table class="table align-middle"><caption>Supplier registration applications</caption><thead><tr><th scope="col">Company</th><th scope="col">Registration number</th><th scope="col">Contact</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach (var supplier in Model) { <tr><th scope="row" class="text-break">@supplier.CompanyName</th><td class="text-break">@supplier.RegistrationNumber</td><td class="text-break">@supplier.ContactEmail</td><td><span class="status-pill">@supplier.Status</span></td><td><a asp-action="Details" asp-route-id="@supplier.Id" class="table-action">Review</a></td></tr> }
</tbody></table></div>
}
