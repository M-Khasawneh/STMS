@model SourcingTenderManagementSystem.Web.Models.Suppliers.SupplierReviewViewModel
@using SourcingTenderManagementSystem.Web.Models.Entities
@{ ViewData["Title"] = "Supplier review"; var supplier = Model.Supplier!; }
<div class="row form-layout"><section class="form-panel" aria-labelledby="review-title"><div class="eyebrow">SUPPLIER REVIEW</div><h1 id="review-title">Review application</h1>
@if (TempData["SupplierStatus"] is string status) { <div class="alert alert-success" role="status">@status</div> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<partial name="_SupplierDetails" model="Model" />
@if (supplier.Status is SupplierStatus.Pending or SupplierStatus.Approved) {
<form asp-action="Review" asp-route-id="@supplier.Id" method="post" data-supplier-review>
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input asp-for="ExpectedStatus" type="hidden" />
<div class="mb-3"><label asp-for="Decision" class="form-label"></label><select asp-for="Decision" class="form-select"><option value="">Select a decision</option>
@if (supplier.Status == SupplierStatus.Pending) { <option value="Approved">Approve</option><option value="Rejected">Reject</option> } else { <option value="Suspended">Suspend</option> }
</select><span asp-validation-for="Decision" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="4" maxlength="2000" aria-describedby="reason-help"></textarea><div id="reason-help" class="form-text">A documented reason is required for rejection or suspension.</div><span asp-validation-for="Reason" class="text-danger"></span></div>
<div class="form-actions d-flex gap-2 flex-wrap"><button type="submit" class="btn btn-primary">Save decision</button><a asp-action="Index" class="btn btn-outline-secondary">Back to applications</a></div></form>
} else { <a asp-action="Index" class="btn btn-outline-secondary">Back to applications</a> }
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/suppliers.js" asp-append-version="true"></script> }

@section Styles { <link rel="stylesheet" href="~/css/supplier-expiry.css" asp-append-version="true" /> }
