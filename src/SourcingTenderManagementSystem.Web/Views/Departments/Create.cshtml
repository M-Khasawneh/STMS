@model SourcingTenderManagementSystem.Web.Models.Departments.DepartmentFormViewModel
@{ ViewData["Title"] = "Create department"; }
<div class="row form-layout">
    <section class="col-12 col-md-8 col-lg-6 form-panel" aria-labelledby="department-title">
        <div class="eyebrow">ORGANIZATION</div>
        <h1 id="department-title">Create department</h1>
        <form asp-action="Create" method="post">
            <partial name="_DepartmentFields" model="Model" />
            <div class="d-flex flex-wrap gap-2 form-actions">
                <button type="submit" class="btn btn-primary">Create department</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
