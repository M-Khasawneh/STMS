@model IReadOnlyList<SourcingTenderManagementSystem.Web.Models.Entities.Department>
@{ ViewData["Title"] = "Departments"; }
<div class="page-heading"><div><div class="eyebrow">ORGANIZATION</div><p class="page-intro">Keep your organization clearly connected.</p></div><div class="record-count"><span data-count="@Model.Count">@Model.Count</span><small>departments</small></div></div>
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 collection-heading">
    <h1 class="mb-0">Departments</h1>
    <a asp-action="Create" class="btn btn-primary">Create department</a>
</div>
@if (TempData["DepartmentStatus"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}
@if (Model.Count == 0)
{
    <p>No departments have been created.</p>
}
else
{
    <div class="table-responsive" role="region" aria-label="Departments table" tabindex="0">
        <table class="table align-middle">
            <caption>Company departments</caption>
            <thead><tr><th scope="col">Department name</th><th scope="col">Actions</th></tr></thead>
            <tbody>
                @foreach (var department in Model)
                {
                    <tr>
                        <td class="text-break">@department.Name</td>
                        <td><a class="table-action" asp-action="Edit" asp-route-id="@department.Id" aria-label="Edit @department.Name">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
