@model IReadOnlyList<SourcingTenderManagementSystem.Web.Models.Entities.Department>
@{ ViewData["Title"] = "Departments"; }
<header class="page-heading"><div><div class="eyebrow">ORGANIZATION</div><h1>Departments</h1><p>Keep your organization clearly connected.</p></div><div class="page-heading-actions"><div class="record-count"><span data-count="@Model.Count">@Model.Count</span><small>departments</small></div><a asp-action="Create" class="btn btn-primary">Create department</a></div></header>
@if (TempData["DepartmentStatus"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}
@if (Model.Count == 0)
{
    <section class="workspace-empty-state"><h2>No departments yet</h2><p>No departments have been created.</p></section>
}
else
{
    <div class="table-responsive" role="region" aria-label="Departments table" tabindex="0">
        <table class="table align-middle">
            <caption>Company departments</caption>
            <thead><tr><th scope="col">Department name</th><th scope="col">Actions</th></tr></thead>
            <tbody>
                @foreach (var department in Model)
                {
                    <tr>
                        <th scope="row" class="text-break">@department.Name</th>
                        <td><a class="table-action" asp-action="Edit" asp-route-id="@department.Id" aria-label="Edit @department.Name">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
