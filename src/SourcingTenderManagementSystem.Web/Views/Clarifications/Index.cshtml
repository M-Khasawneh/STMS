@model SourcingTenderManagementSystem.Web.Models.Clarifications.InternalInbox
@using SourcingTenderManagementSystem.Web.Models.Entities
@{ ViewData["Title"]="Clarifications"; }
<div class="page-heading"><div><div class="eyebrow">CONNECTED WORK</div><h1>Clarifications</h1><p>Questions and responses for the transactions you are directly involved in.</p></div></div>
<section class="requisition-detail-panel"><h2>Your conversations</h2><p class="form-text">Open a requisition or tender to start a question with an eligible participant. Supplier compliance questions remain in the offer's Compliance section.</p>
@if(Model.Items.Count==0){<p>No eligible internal conversations on this page.</p>}else{
<div class="table-responsive" role="region" aria-label="Clarifications" tabindex="0"><table class="table align-middle"><caption>Your authorized internal clarifications</caption><thead><tr><th scope="col">Subject</th><th scope="col">Related transaction</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col">Action</th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td class="text-break">@item.Request.Subject</td><td class="text-break">@item.ContextTitle</td><td><span class="status-pill">@item.Request.Status</span></td><td>@Amman(item.Request.CreatedAt)</td><td><a asp-action="Details" asp-route-id="@(item.Request.PurchaseRequisitionId??item.Request.TenderId)" asp-route-requisition="@item.Request.PurchaseRequisitionId.HasValue" class="btn btn-outline-secondary">Open conversation</a></td></tr>}
</tbody></table></div>}
<nav aria-label="Conversation pages" class="d-flex gap-3">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)">Previous</a>}@if(Model.More){<a asp-action="Index" asp-route-page="@(Model.Page+1)">Next</a>}</nav>
</section>
@functions {string Amman(DateTimeOffset date)=>TimeZoneInfo.ConvertTimeBySystemTimeZoneId(date,"Asia/Amman").ToString("yyyy-MM-dd HH:mm");}
