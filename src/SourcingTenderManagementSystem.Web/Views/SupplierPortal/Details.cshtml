@model SourcingTenderManagementSystem.Web.Models.Work.SupplierPortalPage
@using SourcingTenderManagementSystem.Web.Models.Tenders
@using SourcingTenderManagementSystem.Web.Models.Entities
@using SourcingTenderManagementSystem.Web.Data
@{ ViewData["RecordNavigation"] = true;ViewData["Title"]="Tender workspace";var tender=Model.Tender.Tender;var offer=Model.Offer;}
<div class="work-hub"><header class="work-heading"><div><span class="eyebrow">YOUR COMPANY / TENDER WORKSPACE</span><h1>@tender.Title</h1><p>One place for your invitation, requested items and personal offer.</p></div><a class="btn btn-outline-secondary" asp-controller="Tenders" asp-action="Inbox">My invitations</a></header>
<div class="portal-status"><div><span>Tender</span><strong>@AdminDashboardModel.Label(tender.Status)</strong></div><div><span>Your invitation</span><strong>@Model.Invitation.Invitation.Status</strong></div><div><span>Submission deadline</span><strong>@TenderTime.Display(tender.SubmissionDeadline)</strong></div><div><span>Your offer</span><strong>@(offer?.Details.Snapshot.Bid.Status.ToString()??"Not started")</strong></div></div>
@if(Model.Notice is not null){<p class="alert alert-info" role="status">@Model.Notice</p>}
<partial name="_TenderProgress" model="tender.Status" />
<div class="portal-columns"><div><section class="work-section"><header><h2>Tender brief</h2></header><div class="portal-copy"><h3>Description</h3><p>@tender.Description</p><h3>Terms</h3><p>@tender.Terms</p><h3>Submission period</h3><p>@TenderTime.Display(tender.SubmissionStart) &#8212; @TenderTime.Display(tender.SubmissionDeadline)</p></div></section>
<section class="work-section"><header><h2>Requested items <span>@Model.Tender.Items.Count</span></h2></header><div class="table-responsive" role="region" aria-label="Required tender items" tabindex="0"><table class="table"><caption>Every item and its exact requested quantity must be included in your offer.</caption><thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Specifications</th></tr></thead><tbody>@foreach(var item in Model.Tender.Items){<tr><th scope="row">@item.Description</th><td>@item.Quantity.ToString("0.######")</td><td class="portal-spec">@item.Specifications</td></tr>}</tbody></table></div></section></div>
<aside><section class="work-section"><header><h2>Your next step</h2></header><div class="portal-copy">
@if(Model.CanRespond){<p>Accept or decline this invitation. Your response is final.</p><form asp-controller="Tenders" asp-action="Respond" asp-route-id="@Model.Invitation.Invitation.Id" method="post"><input type="hidden" name="version" value="@TenderManagement.InvitationVersion(Model.Invitation)"/><div class="portal-actions"><button class="btn btn-primary" type="submit" name="decision" value="Accepted">Accept invitation</button><button class="btn btn-outline-secondary" type="submit" name="decision" value="Declined">Decline</button></div></form>}
else if(Model.CanCreate){<p>Your invitation is accepted. Prepare your complete offer before the deadline.</p><a class="btn btn-primary" asp-controller="Bids" asp-action="Create" asp-route-tenderId="@tender.Id">Prepare offer</a>}
else if(offer is not null){<p>@(offer.CanEdit?"Continue your saved draft. Final submission requires an explicit confirmation.":"Your offer is read-only. Submitted offers and documents cannot be changed.")</p><div class="portal-actions">@if(offer.CanEdit){<a class="btn btn-primary" asp-controller="Bids" asp-action="Edit" asp-route-id="@offer.Details.Snapshot.Bid.Id">Continue draft</a>}<a class="btn btn-outline-secondary" asp-controller="Bids" asp-action="Details" asp-route-id="@offer.Details.Snapshot.Bid.Id">Offer details</a><a class="quiet-link" asp-controller="Bids" asp-action="Summary" asp-route-id="@offer.Details.Snapshot.Bid.Id">Download my summary</a></div>}
else{<p>No offer action is currently available. Eligibility, invitation acceptance and the submission period are checked by the system.</p>}
</div></section>
@if(offer is not null){<section class="work-section"><header><h2>Your documents <span>@offer.Details.Snapshot.Documents.Count</span></h2></header><div class="portal-copy"><p>Only documents belonging to your own offer are shown.</p>@if(offer.Details.Snapshot.Documents.Count==0){<p>No documents uploaded yet.</p>}else{<ul class="portal-documents">@foreach(var doc in offer.Details.Snapshot.Documents){<li><a asp-controller="Bids" asp-action="Document" asp-route-id="@offer.Details.Snapshot.Bid.Id" asp-route-documentId="@doc.Id">@doc.OriginalName</a><small>@doc.DocumentType</small></li>}</ul>}</div></section>}
</aside></div><p class="work-footnote">This workspace contains only your company's participation. Existing secure download and offer submission checks apply.</p></div>
