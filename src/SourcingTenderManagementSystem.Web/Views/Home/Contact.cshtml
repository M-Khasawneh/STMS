@model SourcingTenderManagementSystem.Web.Models.ContactMessageForm
@{ ViewData["Title"] = "Contact"; ViewData["PublicWebsite"] = true; }
<div class="contact-page">
    <nav class="contact-breadcrumb" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></nav>
    <div class="contact-page-grid">
        <section data-public-reveal class="contact-copy" aria-labelledby="contact-title"><span class="public-kicker">LET’S CONNECT</span><h1 id="contact-title">Good questions.<br /><span>Clearer possibilities.</span></h1><p>Have a question about STMS or getting started? Send a message directly to the system administrator.</p>
            <div class="contact-delivery-note"><span aria-hidden="true"><partial name="_LinkArrow" /></span><div><h2>Direct to administration</h2><p>Your message is delivered privately through the administrator’s in-app notifications.</p></div></div>
            <div class="contact-help-links"><span>Looking for account access?</span><a asp-controller="Account" asp-action="Login">Sign in to your workspace <partial name="_LinkArrow" /></a><a asp-controller="Suppliers" asp-action="Register">Register your supplier company <partial name="_LinkArrow" /></a></div>
        </section>
        <section data-public-reveal class="contact-form-panel" aria-labelledby="contact-form-title">
            <div class="public-form-heading"><span class="public-kicker">CONTACT STMS</span><h2 id="contact-form-title">What’s on your mind?</h2><p>All fields are required.</p></div>
            @if (TempData["ContactSent"] is string sent) { <div class="alert alert-success" role="status">@sent</div> }
            <form asp-action="Contact" method="post" data-contact-form>
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="public-form-grid"><div><label asp-for="SenderName"></label><input asp-for="SenderName" class="form-control" autocomplete="name" maxlength="100" required /><span asp-validation-for="SenderName" class="text-danger"></span></div><div><label asp-for="Email"></label><input asp-for="Email" type="email" class="form-control" autocomplete="email" maxlength="254" required /><span asp-validation-for="Email" class="text-danger"></span></div></div>
                <div><label asp-for="Subject"></label><input asp-for="Subject" class="form-control" maxlength="180" required /><span asp-validation-for="Subject" class="text-danger"></span></div>
                <div><label asp-for="Message"></label><textarea asp-for="Message" class="form-control" rows="6" maxlength="4000" required aria-describedby="contact-message-help"></textarea><span asp-validation-for="Message" class="text-danger"></span><small id="contact-message-help">Up to 4,000 characters. Your name and email are included with the message.</small></div>
                <button class="public-submit" type="submit">Send message <span aria-hidden="true"><partial name="_LinkArrow" /></span></button>
            </form>
        </section>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
