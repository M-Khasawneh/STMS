@{
    ViewData["Title"] = "About";
    ViewData["PublicWebsite"] = true;
}
@section Styles {
    <meta name="description" content="Learn how STMS is designed to connect purchase requests, sourcing teams and suppliers through a clear, traceable procurement process." />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}
@section PageStyles { <link rel="stylesheet" href="~/css/about-cards.css" asp-append-version="true" /> }
<div class="stms-landing about-page" data-public-page="about">
    <section class="ref-editorial-hero" aria-labelledby="about-page-title">
        <div class="ref-editorial-overline"><span>ABOUT THE PLATFORM</span><span>01 / PURPOSE &amp; PERSPECTIVE</span></div>
        <div class="ref-editorial-title"><h1 id="about-page-title" data-public-reveal>Procurement.<br />With a clear<br /><em>sense of direction.</em></h1><div data-public-reveal><p>From an initial requirement to a documented outcome. One shared framework for people, information and sourcing decisions.</p><a href="#mission-title">Discover our purpose <span aria-hidden="true">↓</span></a></div></div>
        <div class="ref-about-panorama" aria-hidden="true" data-public-reveal><span>STRUCTURE. CLARITY. CONNECTION.</span><span>THE STMS SOURCING PLATFORM</span></div>
    </section>
    <section class="public-mission" aria-labelledby="mission-title">
        <div data-public-reveal><div class="stms-eyebrow">THE PURPOSE</div><h2 id="mission-title">Bring the process<br /><span>together.</span></h2></div>
        <div data-public-reveal data-ac-stagger="90"><p class="public-mission-statement">Purchasing works better when people and information share a clear structure.</p><p>The Sourcing &amp; Tender Management System is designed to replace scattered paperwork, emails and spreadsheets with one central place for purchase requests, tenders, supplier offers, documents, evaluations and decisions.</p><p>Its purpose is to support communication between departments, sourcing teams and suppliers, while keeping the context behind purchasing decisions traceable.</p></div>
    </section>
    <section class="public-lifecycle" aria-labelledby="lifecycle-title">
        <div class="public-section-heading" data-public-reveal><div><div class="stms-eyebrow">THE SOURCING LIFECYCLE</div><h2 id="lifecycle-title">From a need<br /><span>to a documented outcome.</span></h2></div><p>An overview of the process described in the system requirements. Workspace access and available actions depend on your role.</p></div>
        <ol class="public-lifecycle-list">
            <li data-public-reveal><span class="public-stage-number" aria-hidden="true">01</span><div><h3>Identify &amp; request</h3><p>A department identifies a need and records a purchase request with its reason, priority, target date, items, quantities and specifications.</p></div></li>
            <li data-public-reveal><span class="public-stage-number" aria-hidden="true">02</span><div><h3>Review &amp; prepare</h3><p>The request is reviewed for approval, return or rejection. The Sourcing Officer prepares the tender, its terms and submission dates.</p></div></li>
            <li data-public-reveal><span class="public-stage-number" aria-hidden="true">03</span><div><h3>Invite &amp; receive</h3><p>Suitable suppliers are invited to participate. The workflow calls for offers containing pricing, technical information and supporting documents before the deadline.</p></div></li>
            <li data-public-reveal><span class="public-stage-number" aria-hidden="true">04</span><div><h3>Check &amp; evaluate</h3><p>Mandatory requirements are checked. Technical and financial evaluation follows established criteria and weights, with observations recorded by the evaluation committee.</p></div></li>
            <li data-public-reveal><span class="public-stage-number" aria-hidden="true">05</span><div><h3>Report &amp; decide</h3><p>A unified report brings the evaluation and recommendation to the Sourcing Manager. High-value or critical tenders proceed to the Top Committee for a final group decision.</p></div></li>
            <li data-public-reveal><span class="public-stage-number" aria-hidden="true">06</span><div><h3>Award &amp; close</h3><p>The sourcing lifecycle concludes by recording the winning supplier, closing the tender and notifying the parties, with decisions and supporting records retained.</p></div></li>
        </ol>
    </section>
    <section class="public-benefits" aria-labelledby="benefits-title">
        <div data-public-reveal><div class="stms-eyebrow">THE DESIGN PRINCIPLES</div><h2 id="benefits-title">Clarity at<br /><span>every handoff.</span></h2><p>The platform's objectives focus on shared information, clearer communication and traceable decisions.</p></div>
        <div class="public-benefit-grid" data-public-reveal data-ac-stagger="100"><article><span aria-hidden="true">01 /</span><h3>Centralize information</h3><p>Keep requests, tenders and their supporting documents in a shared system instead of scattered records.</p></article><article><span aria-hidden="true">02 /</span><h3>Connect participants</h3><p>Support communication between departments, sourcing teams and suppliers, with access appropriate to each role.</p></article><article><span aria-hidden="true">03 /</span><h3>Preserve context</h3><p>Maintain a clear history of offers, reviews, decisions and approvals to support transparency and informed choices.</p></article></div>
    </section>
    <section class="public-page-next" aria-label="Account access" data-public-reveal><div><div class="stms-eyebrow">YOUR NEXT STEP</div><h2>Find your place<br /><span>in the process.</span></h2></div><div class="stms-actions"><a asp-controller="Account" asp-action="Login" class="stms-button stms-button-primary">Account login <span aria-hidden="true">&#8599;</span></a><a asp-controller="Suppliers" asp-action="Register" class="stms-text-link">Supplier Registration <span aria-hidden="true">&#8599;</span></a></div></section>
</div>
