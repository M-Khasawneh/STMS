@model PublicHomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["PublicHome"] = true;
    ViewData["PremiumLanding"] = true;
}
@section Styles {
    <meta name="description" content="STMS connects purchase requests, sourcing teams and suppliers through one traceable sourcing process." />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing-premium.css" asp-append-version="true" />
}
<div class="stms-landing landing-redesign">
    <section id="home" class="lp-hero" aria-labelledby="home-title">
        <div class="lp-grid" aria-hidden="true"></div>
        <div class="lp-container lp-hero-grid">
            <div class="lp-hero-copy">
                <p class="lp-kicker" data-enter>SOURCING &amp; TENDER MANAGEMENT SYSTEM</p>
                <h1 id="home-title" data-enter>Unified Platform for <span>Sourcing &amp; Tender Management</span></h1>
                <p class="lp-lead" data-enter>From the first request to the final decision. Bring your departments, sourcing teams and suppliers together through one clear, connected process.</p>
                <div class="lp-actions" data-enter>
                    <a asp-controller="Account" asp-action="Login" class="lp-button lp-button-primary">Access your workspace <span aria-hidden="true">↗</span></a>
                    <a href="#how-it-works" class="lp-button lp-button-outline">Explore the process <span aria-hidden="true">↓</span></a>
                </div>
                <p class="lp-hero-note" data-enter>Role-based access. Documents and decisions in context.</p>
            </div>
            <div class="lp-visual" data-enter role="img" aria-label="Illustration of a connected sourcing process linking requests, tenders and suppliers.">
                <div class="lp-orbit lp-orbit-one"></div><div class="lp-orbit lp-orbit-two"></div><div class="lp-orbit lp-orbit-three"></div>
                <div class="lp-orbit-center lp-logo-center"><img src="~/images/brand/stms-logo.png" asp-append-version="true" alt="" width="250" height="250" fetchpriority="high" /></div>
                <div class="lp-orbit-label lp-label-request"><span aria-hidden="true">↗</span> Purchase requests</div>
                <div class="lp-orbit-label lp-label-tender"><span aria-hidden="true">▤</span> Tender management</div>
                <div class="lp-orbit-label lp-label-supplier"><span aria-hidden="true">◇</span> Supplier participation</div>
                <div class="lp-visual-caption">STRUCTURED FROM THE START</div>
            </div>
        </div>
        <div class="lp-container lp-metrics" aria-label="Public system statistics">
            <div><strong>@(Model.ActiveTenders?.ToString("N0") ?? "Unavailable")</strong><span>Active tenders</span><small>Recorded Open tenders</small></div>
            <div><strong>@(Model.ApprovedSuppliers?.ToString("N0") ?? "Unavailable")</strong><span>Approved suppliers</span><small>Approved company registrations</small></div>
            <div><strong>@(Model.ConvertedRequests?.ToString("N0") ?? "Unavailable")</strong><span>Requests converted to tender</span><small>Completed requisition conversions</small></div>
            <p>A clearer perspective.<br /><span>Built on real system data.</span></p>
        </div>
    </section>

    <section class="lp-capabilities lp-section" aria-labelledby="capabilities-title">
        <div class="lp-container">
            <header class="lp-section-heading" data-reveal><p class="lp-kicker">BUILT AROUND YOUR PROCESS</p><h2 id="capabilities-title">Less scattered information.<br /><span>More connected work.</span></h2><p>A shared context for the people, documents and decisions behind every purchase.</p></header>
            <div class="lp-bento">
                <article class="lp-feature lp-feature-wide" data-reveal>
                    <div class="lp-feature-art" aria-hidden="true"><span class="lp-paper"><i></i><i></i><i></i><b>✓</b></span><span class="lp-paper lp-paper-back"></span></div>
                    <div><span class="lp-icon" aria-hidden="true">↗</span><h3>Start with a clear request.</h3><p>Capture the quantities, specifications, reason and target date. Give every review the context it needs.</p><a href="#how-it-works">Follow the workflow <span aria-hidden="true">→</span></a></div>
                </article>
                <article class="lp-feature lp-feature-blue" data-reveal><span class="lp-icon" aria-hidden="true">◇</span><h3>A place for your suppliers.</h3><p>Company registration, invitations and offers come together in each supplier’s own workspace.</p><a asp-controller="Suppliers" asp-action="Register">Become a supplier <span aria-hidden="true">→</span></a><div class="lp-mini-orbits" aria-hidden="true"><i></i><i></i><i></i></div></article>
                <article class="lp-feature lp-feature-strip" data-reveal><span class="lp-icon" aria-hidden="true">◎</span><div><h3>The right work. The right people.</h3><p>Role-based workspaces connect your team to relevant requests, tenders and notifications.</p></div><a asp-controller="Account" asp-action="Login">Account login <span aria-hidden="true">↗</span></a></article>
            </div>
        </div>
    </section>

    <section id="how-it-works" class="lp-workflow lp-section" aria-labelledby="process-title">
        <div class="lp-container lp-workflow-grid">
            <header class="lp-workflow-intro" data-reveal><p class="lp-kicker">HOW IT WORKS</p><h2 id="process-title">A clear path.<br /><span>From need<br />to decision.</span></h2><p>Six connected stages bring structure to the sourcing lifecycle.</p><div class="lp-workflow-meter" aria-hidden="true"><span data-workflow-label>Identify &amp; request</span><i><b></b></i></div></header>
            <ol class="lp-steps">
                <li data-reveal><span class="lp-step-marker" aria-hidden="true">01</span><div><h3>Identify &amp; request</h3><p>Define the product or service needed. Create a purchase request with quantities, specifications, a reason and a target date.</p><small>Requesting department</small></div></li>
                <li data-reveal><span class="lp-step-marker" aria-hidden="true">02</span><div><h3>Review &amp; prepare</h3><p>Review the request for approval, return or rejection. The Sourcing Officer prepares the tender, terms and submission dates.</p><small>Request review · Sourcing Officer</small></div></li>
                <li data-reveal><span class="lp-step-marker" aria-hidden="true">03</span><div><h3>Invite &amp; receive</h3><p>Select suitable suppliers and invite them to submit pricing, technical details and supporting documents before the deadline.</p><small>Sourcing Officer · Suppliers</small></div></li>
                <li data-reveal><span class="lp-step-marker" aria-hidden="true">04</span><div><h3>Check &amp; evaluate</h3><p>Check mandatory requirements. The evaluation committee assesses technical and financial offers against preset criteria and weights.</p><small>Evaluation committee</small></div></li>
                <li data-reveal><span class="lp-step-marker" aria-hidden="true">05</span><div><h3>Report &amp; decide</h3><p>Prepare a unified report for the Sourcing Manager. High-value or critical tenders go to the Top Committee for a final group decision.</p><small>Sourcing Manager · Top Committee</small></div></li>
                <li data-reveal><span class="lp-step-marker" aria-hidden="true">06</span><div><h3>Award &amp; close</h3><p>Record the winning supplier, close the tender and notify the parties. Keep decisions and their supporting records traceable.</p><small>Award · Notification · Closure</small></div></li>
            </ol>
        </div>
    </section>

    <section id="about" class="lp-about lp-section" aria-labelledby="about-title">
        <div class="lp-container lp-about-grid"><div class="lp-about-art" aria-hidden="true" data-reveal><span>One<br />shared<br /><em>purpose.</em></span><i></i></div><div data-reveal><p class="lp-kicker">ABOUT STMS</p><h2 id="about-title">Make the process<br /><span>work together.</span></h2><p>STMS organizes purchasing digitally, from the first request to the final decision. Departments, sourcing teams and suppliers work with a shared context for documents and decisions.</p><a asp-controller="Home" asp-action="About" class="lp-text-link">Discover the platform <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section id="supplier-registration" class="lp-cta lp-section" aria-labelledby="supplier-title">
        <div class="lp-container"><div class="lp-cta-panel" data-reveal><p class="lp-kicker">FOR SUPPLIERS</p><h2 id="supplier-title">Your next opportunity<br /><span>starts with a connection.</span></h2><p>Register your company and submit official documents. An administrator reviews your application before account access is activated.</p><a asp-controller="Suppliers" asp-action="Register" class="lp-button lp-sling-cta">Register your company <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section id="contact" class="lp-contact" aria-labelledby="contact-title"><div class="lp-container" data-reveal><div><p class="lp-kicker">LET’S CONNECT</p><h2 id="contact-title">Find your next step.</h2><p>Public contact details are not yet configured.</p></div><a asp-controller="Home" asp-action="Contact" class="lp-button lp-button-outline">Contact &amp; account access <span aria-hidden="true">↗</span></a></div></section>
</div>
@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
    <script src="~/js/landing-premium.js" asp-append-version="true"></script>
}
