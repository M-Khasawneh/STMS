@model SupplierBidDetails
@{ ViewData["Title"] = "Offer details"; var bid = Model.Details.Snapshot.Bid; }
@section Styles { <link rel="stylesheet" href="~/css/bids.css" asp-append-version="true" /> }
<div class="bid-workspace"><header class="page-heading"><div><span class="eyebrow">MY OFFERS / DETAILS</span><h1>@Model.Tender.Title</h1><p class="bid-reference">Offer @bid.Id</p></div><span class="bid-status @(bid.Status == BidStatus.Draft ? "is-draft" : "")">@bid.Status</span></header>
@if (TempData["BidStatus"] is string message) { <div class="alert alert-success" role="status">@message</div> }
<div class="bid-banner"><p><strong>@(bid.SubmittedAt.HasValue ? "Submitted " + TenderTime.Display(bid.SubmittedAt.Value) : "This offer has not been submitted.")</strong><br />@(Model.CanEdit ? "Continue preparing your offer, then review it before final submission." : Model.ReadOnlyReason)</p><div class="bid-actions"><a asp-action="History" asp-route-id="@bid.Id">Activity history</a><a asp-action="Summary" asp-route-id="@bid.Id" download>Download my summary</a><a asp-controller="Tenders" asp-action="Details" asp-route-id="@bid.TenderId">View tender</a></div></div>
<div class="bid-toolbar"><a asp-action="Index">← My Offers</a>@if (Model.CanEdit) { <div class="bid-actions"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@bid.Id">Edit draft &amp; documents</a><a class="btn btn-primary" asp-action="Submit" asp-route-id="@bid.Id">Review &amp; submit →</a></div> }</div>
@if (bid.SubmittedAt.HasValue && SourcingTenderManagementSystem.Web.Data.BidRules.ClosedStages.Contains(Model.Tender.Status)) { <a class="btn btn-outline-primary" asp-controller="Compliance" asp-action="Details" asp-route-id="@bid.Id">Compliance &amp; clarifications</a> }
<partial name="_OfferContent" model="Model" /></div>
