@model SupplierBidEditor
@foreach (var doc in Model.Documents.OrderBy(x => x.UploadedAt))
{
    <article class="bid-document"><div><span class="eyebrow">@doc.DocumentType</span><h3 class="text-break">@doc.OriginalName</h3><p>@((doc.Size / 1024m).ToString("0.#")) KB · @TenderTime.Display(doc.UploadedAt)</p><a asp-action="Document" asp-route-id="@Model.Id" asp-route-documentId="@doc.Id" asp-route-view="true" target="_blank" rel="noopener">View watermarked copy <span class="visually-hidden">(opens a new tab)</span></a> <a asp-action="Document" asp-route-id="@Model.Id" asp-route-documentId="@doc.Id" download>Download watermarked copy</a></div>
        <div class="bid-document-actions"><details><summary>Replace document</summary><form asp-action="Replace" asp-route-id="@Model.Id" asp-route-documentId="@doc.Id" method="post" enctype="multipart/form-data" data-document-form><input type="hidden" name="Version" value="@Model.Form.Version" /><label for="type-@doc.Id">Document type</label><select name="DocumentType" id="type-@doc.Id" class="form-select" required>@foreach (var type in new[] { "Technical Proposal", "Financial Proposal", "Supporting Document" }) { <option selected="@(doc.DocumentType == type)" value="@type">@type</option> }</select><label for="file-@doc.Id">Replacement file</label><input name="File" id="file-@doc.Id" type="file" class="form-control" accept=".pdf,.jpg,.png" required aria-describedby="bid-upload-policy" /><button type="submit" class="btn btn-outline-secondary">Replace file</button></form></details><form asp-action="RemoveDocument" asp-route-id="@Model.Id" asp-route-documentId="@doc.Id" method="post" data-document-form><input type="hidden" name="version" value="@Model.Form.Version" /><button class="bid-remove" type="submit">Remove file</button></form></div>
    </article>
}
<p id="bid-upload-policy" class="form-text">Only saved Draft documents can be changed. A new file replaces the selected document; it does not add an attachment.</p>
@if (Model.Documents.Count < 10)
{
    <form asp-action="Upload" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="bid-upload" data-document-form><input type="hidden" name="Version" value="@Model.Form.Version" /><div><label for="bid-document-type">Document type</label><select name="DocumentType" id="bid-document-type" class="form-select" required><option value="Technical Proposal">Technical Proposal (required)</option><option value="Financial Proposal">Financial Proposal (optional)</option><option value="Supporting Document">Supporting Document (optional)</option></select></div><div><label for="bid-document-file">Select file · maximum 5 MB</label><input name="File" id="bid-document-file" type="file" class="form-control" accept=".pdf,.jpg,.png" required aria-describedby="bid-upload-policy" /></div><button class="btn btn-outline-secondary" type="submit">Upload document</button></form>
}
else { <p class="bid-notice">Attachment limit reached. Remove or replace an existing document to make changes.</p> }
