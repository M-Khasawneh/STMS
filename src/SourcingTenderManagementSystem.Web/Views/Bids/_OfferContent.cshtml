@model SupplierBidDetails
@{ var s = Model.Details.Snapshot; var bid = s.Bid; }
<section class="bid-panel"><div class="bid-section-heading"><div><span class="eyebrow">SAVED OFFER</span><h2>Commercial &amp; technical terms</h2></div><span class="bid-currency">JOD</span></div><dl class="bid-facts"><div><dt>Delivery timeframe</dt><dd>@bid.DeliveryTimeframe</dd></div><div><dt>Offer valid until</dt><dd>@bid.OfferValidUntil?.ToString("yyyy-MM-dd")</dd></div><div><dt>Payment terms</dt><dd>@bid.PaymentTerms</dd></div><div><dt>Technical details</dt><dd>@bid.TechnicalDetails</dd></div></dl></section>
<section class="bid-panel"><div class="bid-section-heading"><div><span class="eyebrow">PRICING</span><h2>Items &amp; overall total</h2></div></div><div class="table-responsive" tabindex="0" role="region" aria-label="Saved offer prices"><table class="table bid-lines"><thead><tr><th scope="col">Item / specifications</th><th scope="col">Quantity</th><th scope="col">Unit price · JOD</th><th scope="col">Total · JOD</th></tr></thead><tbody>@foreach (var item in s.Items) { <tr><th scope="row">@item.Description<p class="bid-specifications">@item.Specifications</p></th><td>@item.OfferedQuantity.ToString("0.######")</td><td>@item.UnitPrice.ToString("0.######")</td><td>@((item.OfferedQuantity * item.UnitPrice).ToString("0.############"))</td></tr> }</tbody></table></div>
@if (s.Charges.Count > 0) { <h3>Additional costs</h3><dl class="bid-charges-readonly">@foreach (var cost in s.Charges) { <div><dt>@cost.CostType <small>@cost.Notes</small></dt><dd>@cost.Amount.ToString("0.######") JOD</dd></div> }</dl> }
<div class="bid-total"><span>Overall total</span><strong>@Model.Details.Total.ToString("0.############") <small>JOD</small></strong></div></section>
<section class="bid-panel"><div class="bid-section-heading"><div><span class="eyebrow">PRIVATE ATTACHMENTS</span><h2>Documents</h2></div><span class="bid-currency">@s.Documents.Count / 10</span></div>
@if (s.Documents.Count == 0) { <p>No documents uploaded. At least one Technical Proposal is required before submission.</p> }
@foreach (var doc in s.Documents.OrderBy(x => x.DocumentType)) { <div class="bid-document"><div><span class="eyebrow">@doc.DocumentType</span><h3 class="text-break">@doc.OriginalName</h3><p>@((doc.Size / 1024m).ToString("0.#")) KB · @TenderTime.Display(doc.UploadedAt)</p></div><a asp-action="Document" asp-route-id="@bid.Id" asp-route-documentId="@doc.Id" asp-route-view="true" target="_blank" rel="noopener">View watermarked copy <span class="visually-hidden">(opens a new tab)</span></a> <a asp-action="Document" asp-route-id="@bid.Id" asp-route-documentId="@doc.Id" download>Download watermarked copy ↗</a></div> }
</section>
