@model SourcingTenderManagementSystem.Web.Models.Employees.EmployeeEditViewModel
@using SourcingTenderManagementSystem.Web.Security
@{ ViewData["Title"] = "Edit employee"; var employee = Model.Employee!; }
<div class="row form-layout">
    <section class="col-12 col-md-8 col-lg-6 form-panel" aria-labelledby="employee-title">
        <div class="eyebrow">PEOPLE &amp; ACCESS</div>
        <h1 id="employee-title">Edit employee</h1>
        <p>Username: <strong>@employee.UserName</strong></p>
        <p>Status: <strong>@employee.Status</strong></p>
        <form asp-action="Edit" asp-route-id="@employee.Id" method="post">
            <partial name="_ContactFields" model="Model" />
            <div class="form-check mb-3">
                <input asp-for="UpdateRoles" class="form-check-input" />
                <label asp-for="UpdateRoles" class="form-check-label"></label>
            </div>
                <div class="mb-3">
                    <label asp-for="Roles" class="form-label"></label>
                    <select asp-for="Roles" class="form-select" multiple size="6" aria-describedby="role-help" data-role-picker>
                        @foreach (var role in ApplicationRoles.EmployeeRoles) { <option value="@role">@role</option> }
                    </select>
                    <span asp-validation-for="Roles" class="text-danger"></span>
                    <div id="role-help" class="form-text">Current roles are preselected. Roles change only when “Change role assignments” is checked.</div>
                </div>
            @if (employee.IsProtected)
            {
                <p>The first Admin must retain the Admin role. Department assignment does not limit administrative permissions.</p>
            }
            <div class="d-flex flex-wrap gap-2 form-actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
        @if (!employee.IsProtected)
        {
            <hr />
            <form asp-action="SetEnabled" asp-route-id="@employee.Id" method="post" data-popup-inline>
                <input type="hidden" name="enabled" value="@(employee.Disabled ? "true" : "false")" />
                <p>@(employee.Disabled ? "Enable this account to allow employee sign-in again." : "Disable this account to block sign-in and revoke its existing sessions.")</p>
                <button type="submit" class="btn @(employee.Disabled ? "btn-success" : "btn-outline-danger")">@(employee.Disabled ? "Enable employee" : "Disable employee")</button>
            </form>
        }
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
