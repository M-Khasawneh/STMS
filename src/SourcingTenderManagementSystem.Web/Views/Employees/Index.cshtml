@model IReadOnlyList<SourcingTenderManagementSystem.Web.Models.Employees.EmployeeDetails>
@{ ViewData["Title"] = "Employees"; var totalCount = (ViewData["Pagination"] as SourcingTenderManagementSystem.Web.Models.PageInfo)?.Total ?? Model.Count; }
<header class="page-heading"><div><div class="eyebrow">PEOPLE &amp; ACCESS</div><h1>Employees</h1><p>Each employee belongs to one department. Supplier accounts are managed separately.</p></div><div class="page-heading-actions"><div class="record-count"><span data-count="@totalCount">@totalCount</span><small>employees</small></div><a asp-action="Create" class="btn btn-primary">Create employee</a></div></header>
@if (TempData["EmployeeStatus"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}
@if (Model.Count == 0)
{
    <section class="workspace-empty-state"><h2>No employees to display</h2><p>No employee accounts found.</p></section>
}
else
{
    <div class="table-responsive" role="region" aria-label="Employees table" tabindex="0">
        <table class="table staff-table align-middle">
            <caption>Employee accounts</caption>
            <thead><tr><th scope="col">Username</th><th scope="col">Email</th><th scope="col">Department</th><th scope="col">Roles</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td class="text-break">@employee.UserName @if (employee.IsProtected) { <span class="badge text-bg-secondary">Protected Admin</span> }</td>
                        <td class="text-break">@employee.Email</td>
                        <td class="text-break">@employee.DepartmentName</td>
                        <td class="text-break">@string.Join(", ", employee.Roles)</td>
                        <td><span class="status-pill @(employee.Disabled ? "status-disabled" : employee.TemporarilyLocked ? "status-locked" : "status-enabled")">@employee.Status</span></td>
                        <td><a class="table-action" asp-action="Edit" asp-route-id="@employee.Id" aria-label="Edit @employee.UserName">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
