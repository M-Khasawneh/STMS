@model SourcingTenderManagementSystem.Web.Models.Tenders.CriteriaForm
@using SourcingTenderManagementSystem.Web.Models.Entities
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{var d=(TenderDetails)ViewData["Details"]!;ViewData["Title"]="Evaluation criteria";var locked=d.Criteria.Any(x=>x.ApprovedAt.HasValue)||d.Tender.Status is not(TenderStatus.Draft or TenderStatus.Published);}
<div class="row form-layout"><section class="form-panel"><div class="eyebrow">EVALUATION PREREQUISITE</div><h1>Criteria &amp; percentage weights</h1><p>@d.Tender.Title. Approval requires exactly 100% total weight and a Sourcing Manager who did not configure the current criteria.</p>
@if(d.Actor.Manage&&!locked){<form asp-action="Criteria" asp-route-id="@d.Tender.Id" method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Version" type="hidden" />
@for(var i=0;i<Model.Items.Count;i++){<fieldset class="requisition-item"><legend>Criterion @(i+1)</legend><input asp-for="Items[i].Id" type="hidden" /><div class="mb-3"><label asp-for="Items[i].Name" class="form-label"></label><input asp-for="Items[i].Name" class="form-control" /><span asp-validation-for="Items[i].Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Items[i].Description" class="form-label"></label><textarea asp-for="Items[i].Description" class="form-control"></textarea><span asp-validation-for="Items[i].Description" class="text-danger"></span></div><div class="mb-3"><label asp-for="Items[i].Kind" class="form-label"></label><select asp-for="Items[i].Kind" class="form-select"><option value="">Select kind</option><option value="Technical">Technical</option><option value="Financial">Financial</option></select><span asp-validation-for="Items[i].Kind" class="text-danger"></span></div><div class="mb-3"><label asp-for="Items[i].Weight" class="form-label">Weight (%)</label><input asp-for="Items[i].Weight" type="number" step="0.000001" min="0" max="100" class="form-control" /><span asp-validation-for="Items[i].Weight" class="text-danger"></span></div><button type="submit" name="removeItem" value="@i" formnovalidate class="btn btn-outline-danger">Remove criterion</button></fieldset>}
<div class="form-actions d-flex flex-wrap gap-2"><button type="submit" name="command" value="AddItem" formnovalidate class="btn btn-outline-secondary">Add criterion</button><button type="submit" name="command" value="Save" class="btn btn-primary">Save criteria</button></div></form>}
else {<p>@(locked?"Approved or later-stage criteria are read-only.":"Review the configured criteria below.")</p>}
<div class="table-responsive" role="region" aria-label="Configured criteria" tabindex="0"><table class="table"><caption>Total weight: @d.Criteria.Sum(x=>x.Weight).ToString("0.######")%</caption><thead><tr><th scope="col">Criterion</th><th scope="col">Kind</th><th scope="col">Weight</th><th scope="col">Approval</th></tr></thead><tbody>@foreach(var c in d.Criteria){<tr><td class="text-break"><strong>@c.Name</strong><p>@c.Description</p></td><td>@c.Kind</td><td>@c.Weight.ToString("0.######")%</td><td>@(c.ApprovedAt.HasValue?TenderTime.Display(c.ApprovedAt.Value):"Not approved")</td></tr>}</tbody></table></div>
@if(d.Actor.Approve&&!locked){<form asp-action="ApproveCriteria" asp-route-id="@d.Tender.Id" method="post" class="mt-4"><input type="hidden" name="version" value="@d.Version" /><button type="submit" class="btn btn-primary">Approve criteria &amp; weights</button></form>}
<a asp-action="Details" asp-route-id="@d.Tender.Id" class="quiet-link">Back to tender</a></section></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
