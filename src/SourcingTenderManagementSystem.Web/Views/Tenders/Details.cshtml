@inject SourcingTenderManagementSystem.Web.Data.IInternalClarifications Clarifications
@model SourcingTenderManagementSystem.Web.Models.Tenders.TenderDetails
@using SourcingTenderManagementSystem.Web.Models.Entities
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ViewData["Title"]=Model.Tender.Title;var t=Model.Tender;}
<div class="page-heading"><div><div class="eyebrow">TENDER DETAILS</div><h1>@t.Title</h1><p>Submission window: @TenderTime.Display(t.SubmissionStart) &mdash; @TenderTime.Display(t.SubmissionDeadline)</p></div><span class="status-pill">@t.Status</span></div>
@if(TempData["TenderStatus"] is string message){<div class="alert alert-success" role="status">@message</div>}
@if (!User.IsInRole("Admin") && !User.IsInRole("Supplier") && await Clarifications.AvailableAsync(User,false,t.Id,Context.RequestAborted)) { <a asp-controller="Clarifications" asp-action="Details" asp-route-id="@t.Id" asp-route-requisition="false" class="btn btn-outline-secondary mb-3">Transaction clarifications</a> }

<div class="d-flex flex-wrap gap-2 mb-3"><a asp-controller="TopCommittee" asp-action="Outcome" asp-route-id="@t.Id" class="btn btn-outline-secondary">Recorded outcome</a>
@if (!User.IsInRole("Admin") && !User.IsInRole("Supplier") && (User.IsInRole("SourcingOfficer") || User.IsInRole("SourcingManager"))) {<a asp-controller="TopCommittee" asp-action="Index" class="btn btn-outline-secondary">Final decisions workspace</a>}</div>
<section class="requisition-detail-panel"><h2>Description</h2><p class="requisition-text">@t.Description</p><h2>Terms</h2><p class="requisition-text">@t.Terms</p>
@if(Model.Actor.SupplierId is null && (Model.Actor.Admin||Model.Actor.Officer||Model.Actor.Requester)){<a asp-controller="Requisitions" asp-action="Details" asp-route-id="@Model.Source.Id" class="quiet-link">Source requisition: @Model.Source.Title</a>}
<p class="form-text">The configured deadline is exclusive. Tender status changes are explicit officer actions; the deadline remains authoritative even while status is Open.</p>
@if(Model.Actor.Manage && t.Status==TenderStatus.Draft){<a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-outline-secondary">Edit Draft</a>}
@if(Model.Actor.Internal){<a asp-action="Criteria" asp-route-id="@t.Id" class="btn btn-outline-secondary">Criteria &amp; approval</a>}
@if (Model.Actor.Manager && !Model.Actor.Admin) { <a asp-controller="Committees" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-outline-secondary">Evaluation committee</a> }
@if (Model.Actor.Manage && t.Status == TenderStatus.Closed) { <form asp-controller="Evaluations" asp-action="Start" asp-route-id="@t.Id" method="post" class="mt-3"><input name="version" type="hidden" value="@Model.Version" /><button class="btn btn-primary" type="submit">Start evaluation</button></form> }
@if(Model.Actor.Admin||Model.Actor.Officer){<a asp-action="Invitations" asp-route-id="@t.Id" class="btn btn-outline-secondary">Supplier invitations</a>}
@if(Model.Actor.Manage && t.Status is TenderStatus.Draft or TenderStatus.Published or TenderStatus.Open){
<form asp-action="ChangeStatus" asp-route-id="@t.Id" method="post" class="mt-3"><input type="hidden" name="version" value="@Model.Version" /><input type="hidden" name="decision" value="@(t.Status==TenderStatus.Draft?TenderStatus.Published:t.Status==TenderStatus.Published?TenderStatus.Open:TenderStatus.Closed)" /><button type="submit" class="btn btn-primary">@(t.Status==TenderStatus.Draft?"Publish tender":t.Status==TenderStatus.Published?"Open submission period":"Close submission period")</button></form>}
@if(Model.Actor.Admin){<p class="form-text mt-3">Admin access is read-only.</p>}
</section>
<h2 class="requisition-section-title">Requested items</h2><div class="table-responsive" tabindex="0" role="region" aria-label="Tender items"><table class="table align-middle requisition-items-table"><thead><tr><th scope="col">Description</th><th scope="col">Quantity</th><th scope="col">Specifications</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td class="text-break">@item.Description</td><td>@item.Quantity.ToString("0.######")</td><td class="text-break">@item.Specifications</td></tr>}</tbody></table></div>
@if(TenderManagementApproved(Model.Criteria)){<h2 class="requisition-section-title">Approved evaluation criteria</h2><ul>@foreach(var c in Model.Criteria){<li>@c.Name &middot; @c.Kind &middot; @c.Weight.ToString("0.######")%</li>}</ul>}
@functions {bool TenderManagementApproved(IReadOnlyList<EvaluationCriterion> criteria)=>SourcingTenderManagementSystem.Web.Data.TenderManagement.Approved(criteria);}

<details class="requisition-detail-panel"><summary>Quick access QR code</summary><p>Scan to open this record. Sign-in and your existing permissions are still required. No access token is embedded.</p><img src="@Url.Action("Qr",new{id=t.Id})" alt="QR code opening these protected details" width="220" height="220" loading="lazy" style="max-width:100%;height:auto"/><p><a asp-action="Qr" asp-route-id="@t.Id" download>Download QR code</a></p></details>
