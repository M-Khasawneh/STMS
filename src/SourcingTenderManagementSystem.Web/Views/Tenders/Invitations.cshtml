@model SourcingTenderManagementSystem.Web.Models.Tenders.TenderInvitations
@using SourcingTenderManagementSystem.Web.Models.Tenders
@using SourcingTenderManagementSystem.Web.Models.Entities
@{ViewData["Title"]="Supplier invitations";}
<div class="page-heading"><div><div class="eyebrow">SUPPLIER INVITATIONS</div><h1>@Model.Details.Tender.Title</h1><p>Invite approved suppliers while the tender is Published. Each supplier can be invited only once.</p></div></div>
@if(Model.Details.Actor.Manage&&Model.Details.Tender.Status==TenderStatus.Published){<form asp-action="Invite" asp-route-id="@Model.Details.Tender.Id" method="post" class="requisition-detail-panel"><input type="hidden" name="Version" value="@Model.Details.Version" /><fieldset><legend class="h5">Eligible suppliers</legend>@foreach(var supplier in Model.Eligible){<div class="form-check mb-3"><input type="checkbox" name="SupplierIds" value="@supplier.Id" id="supplier-@supplier.Id" class="form-check-input" /><label for="supplier-@supplier.Id" class="form-check-label">@supplier.CompanyName</label></div>}</fieldset>@if(Model.Eligible.Count==0){<p>No additional approved eligible suppliers are available.</p>}else{<button type="submit" class="btn btn-primary">Send invitations</button>}</form>}
<div class="table-responsive" role="region" aria-label="Invitations" tabindex="0"><table class="table align-middle"><caption>Invitation tracking</caption><thead><tr><th scope="col">Supplier</th><th scope="col">Status</th><th scope="col">Sent</th><th scope="col">Expires</th></tr></thead><tbody>@foreach(var row in Model.Invitations){<tr><td class="text-break">@row.Supplier.CompanyName</td><td><span class="status-pill">@row.Invitation.Status</span></td><td>@TenderTime.Display(row.Invitation.SentAt)</td><td>@(row.Invitation.ExpiresAt.HasValue?TenderTime.Display(row.Invitation.ExpiresAt.Value):"")</td></tr>}</tbody></table></div><a asp-action="Details" asp-route-id="@Model.Details.Tender.Id" class="quiet-link">Back to tender</a>
