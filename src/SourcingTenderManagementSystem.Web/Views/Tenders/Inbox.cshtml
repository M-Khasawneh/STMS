@model IReadOnlyList<SourcingTenderManagementSystem.Web.Models.Tenders.InvitationRow>
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ViewData["Title"]="My invitations";}
<header class="page-heading"><div><div class="eyebrow">SUPPLIER WORKSPACE</div><h1>My invitations</h1><p>Your company's tender invitations and responses.</p></div><div class="record-count"><span>@Model.Count</span><small>invitations</small></div></header>
@if(Model.Count==0){<section class="workspace-empty-state"><h2>No invitations to display</h2><p>No invitations found.</p></section>}else{<div class="table-responsive" role="region" aria-label="My invitations" tabindex="0"><table class="table align-middle"><thead><tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Deadline</th><th scope="col">Actions</th></tr></thead><tbody>@foreach(var row in Model){<tr><th scope="row" class="text-break">@row.Tender.Title</th><td><span class="status-pill">@row.Invitation.Status</span></td><td>@TenderTime.Display(row.Tender.SubmissionDeadline)</td><td><a asp-controller="SupplierPortal" asp-action="Details" asp-route-id="@row.Tender.Id" class="table-action">Tender workspace</a> <a asp-action="Invitation" asp-route-id="@row.Invitation.Id" class="table-action">View invitation</a></td></tr>}</tbody></table></div>}
