@model SourcingTenderManagementSystem.Web.Models.Reports.ReportPage
@using SourcingTenderManagementSystem.Web.Data
@using SourcingTenderManagementSystem.Web.Models.Entities
@using System.Globalization
@{
 ViewData["Title"]="Reports & insights";var f=Model.Filter;var document=Model.Document;
 var routes=new Dictionary<string,string>{{"Category",f.Category},{"Search",f.Search??""},{"Status",f.Status??""},{"DepartmentId",f.DepartmentId?.ToString()??""},{"TenderId",f.TenderId?.ToString()??""},{"From",f.From?.ToString("yyyy-MM-dd")??""},{"To",f.To?.ToString("yyyy-MM-dd")??""}};
 string[] statuses=f.Category switch{"requests"=>Enum.GetNames<PurchaseRequestStatus>(),"tenders"=>Enum.GetNames<TenderStatus>(),"suppliers"=>Enum.GetNames<SupplierStatus>(),"offers" or "evaluations" or "decisions"=>Enum.GetNames<BidStatus>(),_=>[]};
 var pages=Math.Max(1,document.Tables.Select(t=>(int)Math.Ceiling(t.Rows.Count/25m)).DefaultIfEmpty(1).Max());
}
@section Styles {<link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />}
<div class="reports-workspace">
<header class="page-heading reports-heading"><div><div class="eyebrow">REPORTING WORKSPACE</div><h1>Reports &amp; insights</h1><p>Clear views of the work, decisions and records available to you.</p></div><span class="reports-scope"><span aria-hidden="true">◈</span> Permission-based access</span></header>
<nav class="report-tabs" aria-label="Report categories">@foreach(var category in Model.Categories){<a asp-action="Index" asp-route-category="@category" aria-current="@(category==f.Category?"page":null)">@ReportRules.Label(category)</a>}</nav>
<section class="requisition-detail-panel report-filter" aria-labelledby="filter-heading"><div class="report-panel-heading"><div><span class="report-kicker">REFINE YOUR VIEW</span><h2 id="filter-heading">@document.Title</h2></div><span class="report-panel-hint">Filter the records available to you</span></div>
<form asp-action="Index" method="get"><input name="Category" type="hidden" value="@f.Category"/><div class="report-filter-fields">
@if(f.Category!="unified") {<div><label for="Search" class="form-label">@(f.Category is "suppliers" or "overview"?"Company":f.Category=="awards"?"Tender, supplier or contract reference":"Title")</label><input class="form-control" type="search" name="Search" id="Search" value="@f.Search" maxlength="200" /></div>}
@if(statuses.Length>0){<div><label for="Status" class="form-label">@(f.Category=="decisions"?"Source bid status":"Status")</label><select class="form-select" name="Status" id="Status"><option value="">All statuses</option>@foreach(var status in statuses){<option value="@status" selected="@(string.Equals(status,f.Status,StringComparison.OrdinalIgnoreCase))">@System.Text.RegularExpressions.Regex.Replace(status,"(?<=[a-z])(?=[A-Z])"," ")</option>}</select></div>}
@if(Model.Departments.Count>0&&f.Category is not ("suppliers" or "unified" or "overview")){<div><label for="DepartmentId" class="form-label">Department</label><select class="form-select" name="DepartmentId" id="DepartmentId"><option value="">All available departments</option>@foreach(var d in Model.Departments){<option value="@d.Id" selected="@(d.Id==f.DepartmentId)">@d.Label</option>}</select></div>}
@if(f.Category is "offers" or "evaluations" or "decisions" or "unified" or "awards"){<div><label for="TenderId" class="form-label">Tender</label><select class="form-select" name="TenderId" id="TenderId" required="@(f.Category=="unified")"><option value="">@(f.Category=="unified"?"Select a tender":"All available tenders")</option>@foreach(var t in Model.Tenders){<option value="@t.Id" selected="@(t.Id==f.TenderId)">@t.Label</option>}</select></div>}
@if(f.Category is not ("suppliers" or "unified" or "overview")){<div><label for="From" class="form-label">@(f.Category=="awards"?"Awarded from (Amman)":"From (Amman)")</label><input class="form-control" name="From" id="From" type="date" value="@f.From?.ToString("yyyy-MM-dd")" /></div><div><label for="To" class="form-label">@(f.Category=="awards"?"Awarded to (inclusive)":"To (inclusive)")</label><input class="form-control" name="To" id="To" type="date" value="@f.To?.ToString("yyyy-MM-dd")" /></div>}
</div><div class="report-actions"><button class="btn btn-primary" type="submit">Apply filters</button><a asp-action="Index" asp-route-category="@f.Category" class="btn btn-outline-secondary">Reset</a></div></form></section>
@if(document.Metrics.Count>0){<div class="report-metrics">@foreach(var metric in document.Metrics){<article><span class="report-metric-mark" aria-hidden="true">&#8801;</span><span>@metric.Label</span><strong>@metric.Value</strong></article>}</div>}
<div class="report-export-heading"><div><span class="report-kicker">REPORT OUTPUT</span><h2>Matching records</h2><p class="form-text">Generated @TimeZoneInfo.ConvertTimeBySystemTimeZoneId(document.GeneratedAt,"Asia/Amman").ToString("yyyy-MM-dd HH:mm") Amman · Exports include all matching records.</p></div>@if(document.Tables.Count>0){<div class="report-actions"><a class="btn btn-outline-secondary" asp-action="Download" asp-all-route-data="routes" asp-route-format="xlsx">Download Excel</a>@if(!ReportExports.HasRightToLeftText(document)){<a class="btn btn-primary" asp-action="Download" asp-all-route-data="routes" asp-route-format="pdf">Download PDF</a>}else{<a class="btn btn-primary" asp-action="Print" asp-all-route-data="routes" target="_blank" rel="noopener">Print / Save PDF <span class="visually-hidden">(opens a new tab)</span></a><span class="form-text">For Arabic text, choose Save as PDF in your browser’s print dialog.</span>}</div>}</div>
@foreach(var table in document.Tables){<section class="requisition-detail-panel report-results" aria-labelledby="table-@document.Tables.ToList().IndexOf(table)"><h2 id="table-@document.Tables.ToList().IndexOf(table)">@table.Title <span class="report-row-count">@table.Rows.Count records</span></h2>
<div class="report-sheet">
@if(document.AccessWatermark is not null){<div class="report-watermark" aria-hidden="true">@document.AccessWatermark</div>}
@if(table.Rows.Count==0){<p>No matching records in your authorized scope.</p>}else{<div class="table-responsive" tabindex="0" role="region" aria-label="@table.Title"><table class="table align-middle"><caption>@table.Title · @(table.Rows.Count>25?"25 rows per page":"All matching rows")</caption><thead><tr>@foreach(var column in table.Columns){<th scope="col">@column</th>}</tr></thead><tbody>@foreach(var row in table.Rows.Skip(table.Rows.Count>25?(f.Page-1)*25:0).Take(25)){<tr>@foreach(var cell in row){<td dir="auto" class="@(cell.Number.HasValue?"report-number":"report-text")">@cell.Text</td>}</tr>}</tbody></table></div>}
</div></section>}
@if(pages>1){<nav class="report-actions" aria-label="Report pages">@if(f.Page>1){<a class="btn btn-outline-secondary" asp-action="Index" asp-all-route-data="routes" asp-route-page="@(f.Page-1)">Previous</a>}<span>Page @f.Page / @pages</span>@if(f.Page<pages){<a class="btn btn-outline-secondary" asp-action="Index" asp-all-route-data="routes" asp-route-page="@(f.Page+1)">Next</a>}</nav>}
<aside class="report-notes" aria-label="Metric definitions and limitations"><h2>How to read this report</h2><ul>@foreach(var note in document.Notes){<li>@note</li>}</ul></aside>

@if(document.AccessWatermark is not null){<details class="report-access-details"><summary>Protected report · access identification</summary><p class="access-stamp" dir="auto">@document.AccessWatermark</p></details>}
</div>
