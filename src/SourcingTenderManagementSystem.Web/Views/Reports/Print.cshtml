@model SourcingTenderManagementSystem.Web.Models.Reports.ReportDocument
@{Layout=null;}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@Model.Title — Sourcing & Tender Management System</title><link rel="stylesheet" href="~/css/report-print.css" asp-append-version="true"/></head><body>
<div class="print-toolbar"><button type="button" data-print-report>Print / Save as PDF</button><p>Choose <strong>Save as PDF</strong> in the print dialog to download this complete report. Arabic text uses your browser's native text layout.</p></div>
@if (Model.AccessWatermark is not null) { <p class="access-stamp" dir="auto">@Model.AccessWatermark</p><div class="report-watermark" aria-hidden="true">@Model.AccessWatermark</div> }
<main><header><span>Sourcing & Tender Management System / AUTHORIZED REPORT</span><h1 dir="auto">@Model.Title</h1><p>Generated @TimeZoneInfo.ConvertTimeBySystemTimeZoneId(Model.GeneratedAt,"Asia/Amman").ToString("yyyy-MM-dd HH:mm")</p></header>
@if(Model.Metrics.Count>0){<dl>@foreach(var metric in Model.Metrics){<div><dt>@metric.Label</dt><dd>@metric.Value</dd></div>}</dl>}
@foreach(var table in Model.Tables){var currencyIndex=Array.IndexOf(table.Columns,"Currency");<section><h2>@table.Title</h2><table><caption>@table.Rows.Count matching records</caption><thead><tr>@for(var c=0;c<table.Columns.Length;c++){if(c==currencyIndex){continue;}<th scope="col" class="@(table.Rows.Any(row=>row[c].Number.HasValue)?"report-number":"report-text")">@table.Columns[c]</th>}</tr></thead><tbody>@if(table.Rows.Count==0){<tr><td colspan="@(table.Columns.Length-(currencyIndex>=0?1:0))">No matching records.</td></tr>}@foreach(var row in table.Rows){<tr>@for(var c=0;c<row.Length;c++){if(c==currencyIndex){continue;}var cell=row[c];<td dir="@(cell.Number.HasValue?"ltr":"auto")" class="@(cell.Number.HasValue?"report-number":"report-text")">@cell.Text@if(currencyIndex==c+1){<span class="money-unit"> @row[currencyIndex].Text</span>}</td>}</tr>}</tbody></table></section>}
<aside><h2>Definitions &amp; filters</h2><ul>@foreach(var note in Model.Notes){<li dir="auto">@note</li>}</ul></aside></main><script src="~/js/report-print.js" asp-append-version="true"></script></body></html>
