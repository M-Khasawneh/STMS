@model SourcingTenderManagementSystem.Web.Models.Account.ProfilePage
@using SourcingTenderManagementSystem.Web.Data
@inject IServiceProvider ProfileServices
@{ ViewData["Title"] = "Profile settings"; }
<div class="profile-settings"><header class="page-heading"><div><div class="eyebrow">YOUR ACCOUNT</div><h1>Profile settings</h1><p>Manage your contact information and password.</p></div></header>
@if (TempData["ProfileStatus"] is string status) { <div class="alert alert-success" role="status">@status</div> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (!User.IsInRole("Supplier")) {
<section class="form-panel"><h2>Profile picture</h2><p>Choose a JPG or PNG image up to 5 MB.</p>
@if (ProfileServices.GetService<IWorkspacePresentation>()?.HasAvatar(User) == true) { <img src="@Url.Action("Avatar")" class="profile-settings-photo" alt="Your profile picture" /> }
<form asp-action="Picture" method="post" enctype="multipart/form-data"><label for="profile-picture">Your picture</label><input id="profile-picture" type="file" name="picture" accept=".jpg,.png" required class="form-control" /><button type="submit" class="btn btn-primary mt-3">Save picture</button></form><form asp-action="RemovePicture" method="post" class="mt-3"><button type="submit" class="btn btn-outline-secondary">Remove picture</button></form></section>
}
<section class="form-panel"><h2>Account information</h2><p>Signed in as <strong>@Model.UserName</strong>. Role and department assignments are managed by an administrator.</p><form asp-action="Contact" method="post"><div class="mb-3"><label asp-for="Contact.Email" class="form-label"></label><input asp-for="Contact.Email" class="form-control" autocomplete="email" /><span asp-validation-for="Contact.Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Contact.PhoneNumber" class="form-label"></label><input asp-for="Contact.PhoneNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="Contact.PhoneNumber" class="text-danger"></span></div><button type="submit" class="btn btn-primary">Save profile</button></form></section>
<section class="form-panel"><h2>Change password</h2><p>Enter your current password to choose a new one. Other sessions will need to sign in again.</p><form asp-action="Password" method="post"><div class="mb-3"><label asp-for="Password.CurrentPassword" class="form-label"></label><input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" value="" /><span asp-validation-for="Password.CurrentPassword" class="text-danger"></span></div><div class="mb-3"><label asp-for="Password.NewPassword" class="form-label"></label><input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" value="" /><span asp-validation-for="Password.NewPassword" class="text-danger"></span></div><div class="mb-3"><label asp-for="Password.ConfirmPassword" class="form-label"></label><input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" value="" /><span asp-validation-for="Password.ConfirmPassword" class="text-danger"></span></div><button type="submit" class="btn btn-primary">Change password</button></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
