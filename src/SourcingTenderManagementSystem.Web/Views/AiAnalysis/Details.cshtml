@model SourcingTenderManagementSystem.Web.Models.Analysis.AiPage
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ViewData["Title"]="AI advisory comparison";}
@section Styles {<link rel="stylesheet" href="~/css/bids.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/ai-analysis.css" asp-append-version="true"/>}
<div class="bid-workspace"><header class="page-heading"><div><span class="eyebrow">LOCAL OLLAMA / HUMAN REVIEW</span><h1>Advisory offer analysis</h1><p>@Model.Evidence.Title</p></div><a asp-controller="ReviewBids" asp-action="Compare" asp-route-tenderId="@Model.Evidence.TenderId" class="btn btn-outline-secondary">Compare original offers</a></header>
<div class="alert alert-info"><strong>Decision support only.</strong> AI observations can be incorrect. Verify their cited facts and original documents. This tool never changes compliance, scores, approvals or awards. Extracted document excerpts are read locally from authorized files. OCR can be inaccurate; page limits and shortened or unreadable text are shown below.</div>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(Model.Result is null){<section class="bid-panel"><h2>Analyze the available submitted offers</h2><p>The approved local model receives only the offers you are authorized to review. Existing source prices, quantities and totals remain authoritative. No external AI provider is used.</p><form asp-action="Run" asp-route-id="@Model.Evidence.TenderId" method="post" data-ai-run><input type="hidden" name="Version" value="@Model.Evidence.Fingerprint"/><label class="d-flex gap-2 my-3"><input type="checkbox" name="Confirm" value="true" required/> I understand that this is preliminary advice requiring human verification.</label><button type="submit" class="btn btn-primary">Generate local analysis</button><p class="form-text mt-2" role="status" data-ai-status>Document extraction and local generation may take up to five minutes. Keep this page open.</p></form></section>}
else{<section class="bid-panel"><span class="eyebrow">PRESERVED ADVISORY RESULT</span><p>@Model.Result.Model · @TenderTime.Display(Model.Result.CreatedAt)</p><h2>Comparison</h2><p class="ai-advisory-copy">@Model.Result.Advice.Comparison</p><h2>Preliminary recommendation</h2><p class="ai-advisory-copy">@Model.Result.Advice.Recommendation</p>@if(Model.Result.Advice.RecommendedBidId is Guid suggested){<p>Suggested compliant offer: @Model.Evidence.Offers.Single(o=>o.BidId==suggested).Supplier. This is not an approval or award.</p>}</section>}
@if(Model.Result is not null){<section class="bid-panel"><h2>Document extraction coverage</h2><p>Only the excerpts displayed here were supplied to AI. Up to 10 pages per file and 20 attachments per analysis; additional pages and text beyond the context budget are omitted explicitly. An unreadable or shortened document is not automatically non-compliant.</p>
@foreach(var doc in Model.Result.Documents){var company=Model.Evidence.Offers.Single(o=>o.BidId==doc.BidId).Supplier;<article class="mb-4"><h3 class="h5">@company · @doc.Type</h3><p>Document @doc.DocumentId · @doc.Extraction.Status · processed @doc.Extraction.Pages.Count / @doc.Extraction.TotalPages pages</p>
@if(doc.Extraction.Pages.Count==0){<p class="text-danger">No document text is available. Review the original protected file.</p>}
@foreach(var extractedPage in doc.Extraction.Pages){<details class="mb-2"><summary>Page @extractedPage.Number · @extractedPage.Method @(extractedPage.Confidence.HasValue?$"· OCR confidence {extractedPage.Confidence.Value:P0}":"") @(extractedPage.Truncated?"· shortened/omitted excerpt":"")</summary><p class="ai-advisory-copy">@(string.IsNullOrWhiteSpace(extractedPage.Text)?"No readable excerpt was supplied to AI for this page.":extractedPage.Text)</p></details>}
</article>}</section>}
@foreach(var offer in Model.Evidence.Offers){var advice=Model.Result?.Advice.Offers.Single(o=>o.BidId==offer.BidId);<section class="bid-panel"><header><h2>@offer.Supplier</h2><p><span class="bid-status">@offer.Status</span> · <strong>@offer.Total.ToString("0.############") JOD</strong></p><a asp-controller="ReviewBids" asp-action="Details" asp-route-id="@offer.BidId">Review original offer and protected documents</a></header><p class="mt-3">Delivery: @offer.Delivery</p><p class="text-break">Technical details: @offer.Technical</p>@if(offer.MissingDocuments.Count>0){<div class="alert alert-warning">Missing mandatory document inventory: @string.Join(", ",offer.MissingDocuments). Human compliance review remains authoritative.</div>}@if(advice is not null){@foreach(var group in new[]{("Strengths",advice.Strengths),("Weaknesses / uncertainties",advice.Weaknesses)}){<h3 class="h5 mt-4">@group.Item1</h3>@if(group.Item2.Length==0){<p>No observation recorded.</p>}<ul>@foreach(var observation in group.Item2){<li class="mb-3 text-break">@observation.Text<details><summary>Verify cited source facts</summary><dl>@foreach(var key in observation.Evidence){var fact=offer.Facts.Single(f=>f.Key==key);<dt class="text-break">@fact.Key</dt><dd class="text-break">@fact.Value</dd>}</dl></details></li>}</ul>}}</section>}
</div>

@section Scripts {<script src="~/js/ai-analysis.js" asp-append-version="true"></script>}
