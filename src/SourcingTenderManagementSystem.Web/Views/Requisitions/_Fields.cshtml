@model SourcingTenderManagementSystem.Web.Models.Requisitions.RequisitionForm
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Version" type="hidden" />
<section class="request-form-section" aria-labelledby="request-overview"><h2 id="request-overview"><span class="form-section-number">01</span> Request overview</h2>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" maxlength="256" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="3"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div>
<div class="supplier-field-grid"><div class="mb-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option value="">Select a priority</option>@foreach (var priority in new[] { "Low", "Medium", "High", "Urgent" }) { <option value="@priority">@priority</option> }</select><span asp-validation-for="Priority" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="TargetDate" class="form-label"></label><input asp-for="TargetDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" aria-describedby="target-help" /><span asp-validation-for="TargetDate" class="text-danger"></span><div id="target-help" class="form-text">At submission, the date must be @Model.Today.ToString("yyyy-MM-dd") or later (server calendar).</div></div></div>
</section>
<div class="requisition-section-heading"><h2><span class="form-section-number">02</span> Request items</h2><button type="submit" name="command" value="AddItem" class="btn btn-outline-secondary" formnovalidate data-add-item>Add item</button></div>
<p class="form-text">Submission requires at least one item. Quantities must be positive, with up to six decimal places. Specifications are required for each item. A draft may contain no items.</p>
<div data-requisition-items>
@for (var i = 0; i < Model.Items.Count; i++) {
<fieldset class="requisition-item" data-requisition-item><legend>Item <span data-item-number>@(i + 1)</span></legend><input asp-for="Items[i].Id" type="hidden" />
<div class="mb-3"><label asp-for="Items[i].Description" class="form-label"></label><input asp-for="Items[i].Description" class="form-control" /><span asp-validation-for="Items[i].Description" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Items[i].Quantity" class="form-label"></label><input asp-for="Items[i].Quantity" type="number" step="0.000001" min="0.000001" max="999999999999.999999" class="form-control" /><span asp-validation-for="Items[i].Quantity" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Items[i].Specifications" class="form-label"></label><textarea asp-for="Items[i].Specifications" class="form-control" rows="2"></textarea><span asp-validation-for="Items[i].Specifications" class="text-danger"></span></div>
<button type="submit" name="removeItem" value="@i" class="btn btn-outline-danger" formnovalidate data-remove-item>Remove item <span class="visually-hidden">@(i + 1)</span></button></fieldset>
}
</div>
<template data-item-template><fieldset class="requisition-item" data-requisition-item><legend>Item <span data-item-number></span></legend>
<div class="mb-3"><label for="Items___index___Description" class="form-label">Description</label><input id="Items___index___Description" name="Items[__index__].Description" class="form-control" data-val="true" data-val-required="Description is required." /><span data-valmsg-for="Items[__index__].Description" data-valmsg-replace="true" class="text-danger"></span></div>
<div class="mb-3"><label for="Items___index___Quantity" class="form-label">Quantity</label><input id="Items___index___Quantity" name="Items[__index__].Quantity" type="number" step="0.000001" min="0.000001" max="999999999999.999999" class="form-control" data-val="true" data-val-required="Quantity is required." data-val-number="Enter a valid quantity." data-val-range="Quantity must be positive and fit the supported range." data-val-range-min="0.000001" data-val-range-max="999999999999.999999" /><span data-valmsg-for="Items[__index__].Quantity" data-valmsg-replace="true" class="text-danger"></span></div>
<div class="mb-3"><label for="Items___index___Specifications" class="form-label">Specifications</label><textarea id="Items___index___Specifications" name="Items[__index__].Specifications" class="form-control" rows="2" data-val="true" data-val-required="Specifications are required."></textarea><span data-valmsg-for="Items[__index__].Specifications" data-valmsg-replace="true" class="text-danger"></span></div>
<button type="submit" name="removeItem" class="btn btn-outline-danger" formnovalidate data-remove-item>Remove item</button></fieldset></template>
<p class="visually-hidden" aria-live="polite" data-item-feedback></p>
<div class="form-actions d-flex gap-2 flex-wrap"><button type="submit" name="command" value="SaveDraft" class="btn btn-outline-secondary">Save draft</button><button type="submit" name="command" value="Submit" class="btn btn-primary">Submit for review</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
