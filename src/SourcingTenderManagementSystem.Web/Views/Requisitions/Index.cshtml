@using SourcingTenderManagementSystem.Web.Models.Requisitions
@model SourcingTenderManagementSystem.Web.Models.Requisitions.RequisitionList
@{ ViewData["Title"] = "Purchase requisitions"; }
<div class="page-heading"><div><div class="eyebrow">PURCHASE REQUISITIONS</div><h1>Purchase requisitions</h1><p>@(Model.Actor.Admin ? "Read-only oversight of requisitions across departments." : Model.Actor.Officer ? "Review requisitions across departments. Your own and your department's requests are excluded from review." : "Your purchase requisitions, current statuses and review history.")</p></div><div class="record-count"><span data-count="@Model.Requests.Count">@Model.Requests.Count</span><small>requests</small></div></div>
@if (Model.Actor.CanCreate) { <a asp-action="Create" class="btn btn-primary">Create requisition</a> }
@if (Model.Requests.Count == 0) { <section class="workspace-empty-state"><h2>No requisitions to display</h2><p>No requisitions found.</p></section> } else {
<div class="table-responsive" role="region" aria-label="Purchase requisitions" tabindex="0"><table class="table align-middle"><caption>Purchase requisitions</caption><thead><tr><th scope="col">Title</th><th scope="col">Priority</th><th scope="col">Target date</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach (var request in Model.Requests) { <tr><th scope="row" class="text-break">@request.Title</th><td><span class="priority-tag" data-priority="@request.Priority">@request.Priority</span></td><td>@request.TargetDate.ToString("yyyy-MM-dd")</td><td><span class="status-pill">@RequisitionDisplay.Status(request.Status)</span></td><td><a asp-action="Details" asp-route-id="@request.Id" class="table-action">Details</a></td></tr> }
</tbody></table></div> }
