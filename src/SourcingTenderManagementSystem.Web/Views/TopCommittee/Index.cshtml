@model IReadOnlyList<SourcingTenderManagementSystem.Web.Models.TopCommittee.TopTenderRow>
@{ViewData["Title"]="Final decisions";}
<div class="page-heading"><div><div class="eyebrow">TOP COMMITTEE / FINAL DECISIONS</div><h1>Decisions with a clear record.</h1><p>Your current appointments and responsible tenders. Access is rechecked for every action.</p></div></div>
@if(TempData["TopMessage"] is string message){<div class="alert alert-success" role="status">@message</div>}
<section class="requisition-detail-panel"><h2>Available tenders</h2>@if(Model.Count==0){<p>No tenders are available for your current role, appointment and process stage.</p>}else{<div class="table-responsive" tabindex="0" role="region" aria-label="Final-decision tenders"><table class="table align-middle"><caption>Tenders within your authorized final-decision scope</caption><thead><tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Review</th></tr></thead><tbody>@foreach(var row in Model){<tr><td class="text-break">@row.Title</td><td><span class="status-pill">@row.Status</span></td><td><a asp-action="Details" asp-route-id="@row.Id" class="btn btn-outline-secondary">Review final stage</a></td></tr>}</tbody></table></div>}</section>
