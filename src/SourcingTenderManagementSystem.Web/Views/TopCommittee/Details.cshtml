@model SourcingTenderManagementSystem.Web.Models.TopCommittee.TopPage
@using SourcingTenderManagementSystem.Web.Models.Entities
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ViewData["Title"]="Top Committee review";var current=Model.Members.Where(m=>m.Member.EffectiveTo is null).ToArray();var approved=Model.Rounds.LastOrDefault(r=>r.Round.EvaluationReportId==Model.ReportId&&r.Round.Decision==DecisionStatus.CommitteeApproved);}
@section Styles {<link rel="stylesheet" href="~/css/top-committee.css" asp-append-version="true"/>}
<div class="top-workspace"><header class="page-heading"><div><div class="eyebrow">TOP COMMITTEE / REVIEW</div><h1>@Model.Tender.Title</h1><p>Four independent members. One documented collective outcome.</p></div><span class="status-pill">@Model.Tender.Status</span></header>
@if(TempData["TopMessage"] is string message){<div class="alert alert-success" role="status">@message</div>}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<nav class="top-actions" aria-label="Review context"><a asp-action="Index" class="btn btn-outline-secondary">Final decisions</a>@if(Model.ReportId.HasValue){<a asp-controller="UnifiedReports" asp-action="Details" asp-route-id="@Model.Tender.Id" asp-route-reportId="@Model.ReportId" class="btn btn-outline-secondary">Review report &amp; recommendation</a>}<a asp-controller="ReviewBids" asp-action="Index" asp-route-tenderId="@Model.Tender.Id" class="btn btn-outline-secondary">Authorized submitted offers</a><a asp-action="Outcome" asp-route-id="@Model.Tender.Id" class="btn btn-outline-secondary">Recorded outcome</a></nav>
<section class="requisition-detail-panel top-summary"><div><span class="eyebrow">CURRENT RECOMMENDATION</span><h2>@(Model.RecommendedSupplier??"No submitted recommendation yet")</h2><p>Approval concerns the supplier recommended in the preserved report. Read its findings and supporting offers before voting.</p></div><div class="top-process"><strong>4 votes required</strong><span>At least 3 matching choices</span><small>Without a majority, no final decision is made.</small></div></section>
@if(Model.CanManage){<section class="requisition-detail-panel"><h2>Appoint four independent members</h2><p>Preparers, evaluation participants and report approvers are excluded. Replacing a member preserves the old membership and any votes; an active round is closed and replaced.</p>
@if(Model.Candidates.Count<4){<div class="alert alert-info">Fewer than four eligible existing employees are available. An Admin can assign the existing Top Committee role through employee management.</div>}
<form asp-action="Assign" asp-route-id="@Model.Tender.Id" method="post" data-top-members><input type="hidden" name="Version" value="@Model.Version"/><div class="top-member-fields">@for(int i=0;i<4;i++){var position="Member "+(i+1);var selected=current.FirstOrDefault(m=>m.Member.Position==position)?.Member.UserId;var attempted=ViewData.ModelState[$"Users[{i}]"]?.AttemptedValue;if(attempted is not null){selected=attempted;}<div><label class="form-label" for="member-@i">@position</label><select class="form-select" name="Users[@i]" id="member-@i" required><option value="">Select an eligible employee</option>@foreach(var p in Model.Candidates){<option value="@p.Account.UserId" selected="@(selected==p.Account.UserId)">@p.Name</option>}</select></div>}</div><label class="form-label" for="membership-reason">Reason for replacement @(Model.Members.Count>0?"(required)":"(optional for initial appointment)")</label><textarea id="membership-reason" name="Reason" class="form-control" maxlength="8000" rows="3" required="@(Model.Members.Count>0)"></textarea><button class="btn btn-primary mt-3" type="submit">Save four-member committee</button></form></section>}
@if(Model.CanOpen){<section class="requisition-detail-panel"><h2>Open a voting round</h2><p>The four current memberships and the approved report version are fixed for this round.</p><form asp-action="Open" asp-route-id="@Model.Tender.Id" method="post"><input type="hidden" name="Version" value="@Model.Version"/><label class="form-label" for="round-reason">Reason @(Model.Rounds.Any(r=>r.Round.EvaluationReportId==Model.ReportId)?"(required for another round)":"(optional for the first round)")</label><textarea name="Reason" id="round-reason" class="form-control" rows="3" maxlength="8000" required="@Model.Rounds.Any(r=>r.Round.EvaluationReportId==Model.ReportId)"></textarea><label class="top-confirm"><input type="checkbox" name="Confirm" value="true" required/> I confirm opening this voting round.</label><button class="btn btn-primary" type="submit">Open voting round</button></form></section>}
@if(Model.CanVote){<section class="requisition-detail-panel top-vote"><span class="eyebrow">YOUR FINAL VOTE</span><h2>Record your independent decision</h2><p>Your vote and justification cannot be changed after confirmation. Other members' choices remain hidden until all four votes are recorded.</p><form asp-action="Vote" asp-route-id="@Model.Tender.Id" method="post"><input type="hidden" name="Version" value="@Model.Version"/><input type="hidden" name="RoundId" value="@Model.OpenRoundId"/><label class="form-label" for="Choice">Decision</label><select class="form-select" name="Choice" id="Choice" required><option value="">Choose your decision</option><option value="CommitteeApproved">Approve the recommended supplier</option><option value="CommitteeRejected">Reject the recommendation</option><option value="ReturnedForReview">Request further details</option></select><label class="form-label mt-3" for="vote-reason">Justification</label><textarea class="form-control" id="vote-reason" name="Reason" rows="4" required maxlength="8000">@ViewData.ModelState["Reason"]?.AttemptedValue</textarea><label class="top-confirm"><input type="checkbox" name="Confirm" value="true" required/> I reviewed the report and confirm this immutable vote.</label><button class="btn btn-primary" type="submit">Confirm final vote</button></form></section>}
@if(Model.CanAward&&approved is not null){<section class="requisition-detail-panel top-award"><span class="eyebrow">RESPONSIBLE SOURCING OFFICER</span><h2>Confirm the final award</h2><p>The collective recommendation is approved. This action records the recommended supplier as winner, sets the tender to Awarded, and saves outcome notifications together.</p><form asp-action="Award" asp-route-id="@Model.Tender.Id" method="post"><input type="hidden" name="Version" value="@Model.Version"/><input type="hidden" name="RoundId" value="@approved.Round.Id"/><label class="top-confirm"><input type="checkbox" name="Confirm" value="true" required/> I confirm recording the final award to @Model.RecommendedSupplier.</label><button class="btn btn-primary" type="submit">Record final award</button></form></section>}
@if(Model.Award is not null){<div class="alert alert-success" role="status">Final award recorded @TenderTime.Display(Model.Award.AwardedAt). This tender is read-only.</div>}
<section aria-labelledby="round-heading"><h2 id="round-heading">Voting rounds</h2>@if(Model.Rounds.Count==0){<p>No voting round has been opened.</p>}@foreach(var round in Model.Rounds){<article class="requisition-detail-panel top-round"><div class="top-round-heading"><h3>@(round.Round.RoundClosedAt.HasValue?round.Complete?round.Round.Decision==DecisionStatus.RecommendationPending?"Completed · no majority":"Completed · "+round.Round.Decision:"Closed · membership replaced":"Open voting round")</h3><span class="status-pill">@round.VoteCount / 4 votes</span></div><p class="form-text">Opened @TenderTime.Display(round.Round.RoundOpenedAt!.Value) · report version @round.Round.EvaluationReportId</p>@if(round.Round.RoundClosedAt.HasValue){<p>Closed @TenderTime.Display(round.Round.RoundClosedAt.Value) · @round.Round.RoundCloseReason</p>}@if(!round.Complete){<p class="top-sealed">Individual choices remain sealed. Only your own confirmed vote is shown.</p>}@if(round.Votes.Count>0){<div class="table-responsive" tabindex="0" role="region" aria-label="Visible votes"><table class="table"><thead><tr><th scope="col">Member</th><th scope="col">Decision</th><th scope="col">Justification</th><th scope="col">Recorded</th></tr></thead><tbody>@foreach(var vote in round.Votes){<tr><td>@vote.Member</td><td>@vote.Choice</td><td class="top-copy">@vote.Reason</td><td>@TenderTime.Display(vote.At)</td></tr>}</tbody></table></div>}</article>}</section>
<section class="requisition-detail-panel"><h2>Membership history</h2><div class="table-responsive" tabindex="0" role="region" aria-label="Top Committee membership history"><table class="table"><thead><tr><th scope="col">Position</th><th scope="col">Employee</th><th scope="col">From</th><th scope="col">Until</th><th scope="col">Current eligibility</th></tr></thead><tbody>@foreach(var m in Model.Members){<tr><td>@m.Member.Position</td><td>@m.Name</td><td>@(m.Member.EffectiveFrom.HasValue?TenderTime.Display(m.Member.EffectiveFrom.Value):"Initial appointment")</td><td>@(m.Member.EffectiveTo.HasValue?TenderTime.Display(m.Member.EffectiveTo.Value):"Current")</td><td>@(m.Eligible?"Eligible":"Historical or not currently eligible")</td></tr>}</tbody></table></div></section>
<section class="requisition-detail-panel"><h2>Activity record</h2><ol class="requisition-history">@foreach(var entry in Model.Activity){<li><strong>@entry.Action</strong><small>@TenderTime.Display(entry.OccurredAt)</small><p>@entry.Reason</p></li>}</ol></section></div>
@section Scripts{<script src="~/js/top-committee.js" asp-append-version="true"></script>}
