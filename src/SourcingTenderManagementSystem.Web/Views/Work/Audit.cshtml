@model SourcingTenderManagementSystem.Web.Models.Work.AuditPage
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ViewData["Title"]="Administrative audit";}
<div class="work-hub"><header class="work-heading"><div><span class="eyebrow">ADMINISTRATION / READ ONLY</span><h1>Administrative audit</h1><p>Trace administrative and transaction events. Confidential bid, evaluation and document events and all recorded reasons are excluded.</p></div><a class="btn btn-outline-secondary" asp-controller="Workspace" asp-action="Index">Dashboard</a></header>
<form method="get" asp-action="Audit" class="work-search work-audit-filter"><div><label for="audit-query" class="form-label">Action or exact record ID</label><input id="audit-query" name="q" value="@Model.Query" maxlength="160" class="form-control"/></div><div><label for="audit-type" class="form-label">Record type</label><select class="form-select" id="audit-type" name="type"><option value="">All available types</option>@foreach(var type in new[]{"PurchaseRequisition","Tender","Department","Employee","SupplierProfile"}){<option value="@type" selected="@(type==Model.Type)">@type</option>}</select></div><div><label for="audit-from" class="form-label">From</label><input type="date" name="from" id="audit-from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control"/></div><div><label for="audit-to" class="form-label">To (inclusive)</label><input type="date" name="to" id="audit-to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="work-filter-actions"><button type="submit" class="btn btn-primary">Apply filters</button><a asp-action="Audit">Reset</a></div></form>
<section class="work-section"><header><h2>Recorded events <span>@Model.Total.ToString("N0")</span></h2><span class="work-muted">Metadata only</span></header>
@if(Model.Items.Count==0){<p class="work-section-empty">No matching audit events.</p>}else{<div class="table-responsive" role="region" aria-label="Administrative audit events" tabindex="0"><table class="table"><caption>Read-only administrative metadata; 20 events per page.</caption><thead><tr><th scope="col">Action</th><th scope="col">Record type</th><th scope="col">Record reference</th><th scope="col">Recorded</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><th scope="row">@item.Action</th><td>@item.RecordType</td><td class="work-reference">@item.RecordId</td><td><time datetime="@item.At.ToString("O")">@TenderTime.Display(item.At)</time></td></tr>}</tbody></table></div>}</section>
<nav class="work-pagination" aria-label="Audit pages">@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-action="Audit" asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page-1)">Previous</a>}<span>Page @Model.Page</span>@if((long)Model.Page*20<Model.Total){<a class="btn btn-outline-secondary" asp-action="Audit" asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page+1)">Next</a>}</nav></div>
