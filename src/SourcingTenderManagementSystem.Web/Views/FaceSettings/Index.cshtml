@model SourcingTenderManagementSystem.Web.Models.Account.FacePage
@using SourcingTenderManagementSystem.Web.Models.Tenders
@{ ViewData["Title"] = "Camera face settings"; }
@section Styles { <link rel="stylesheet" href="~/css/face-settings.css" asp-append-version="true" /> }
<div class="profile-settings face-settings">
    <header class="page-heading"><div><span class="eyebrow">YOUR ACCOUNT / CAMERA</span><h1>Face recognition.</h1><p>A private, account-linked face template, with you in control.</p></div><a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Profile settings</a></header>
    @if (!Model.Enabled) {
        <section class="form-panel"><h2>Awaiting activation</h2><p>Camera face registration is not enabled on this installation yet. You can continue using your password or manage secure sign-in on your device.</p><a asp-controller="Passkeys" asp-action="Index" class="btn btn-primary">Manage device face, fingerprint &amp; PIN</a></section>
    } else {
        <section class="form-panel face-enrollment" data-face-settings data-begin="@Url.Action("Begin")" data-complete="@Url.Action("Complete")" data-version="@Model.Version" data-registered="@Model.Registered.ToString().ToLowerInvariant()" data-library="@Url.Content("~/lib/face-api/face-api.js")" data-models="@Url.Content("~/lib/face-api/model")">
            @Html.AntiForgeryToken()
            <div class="face-section-heading"><div><span class="eyebrow">CAMERA TEMPLATE</span><h2>@(Model.Registered ? "Your face is registered" : "Register your face")</h2></div><span class="status-pill">@(Model.Registered ? "Registered" : "Not registered")</span></div>
            @if (Model.UpdatedAt is not null) { <p>Last updated @TenderTime.Display(Model.UpdatedAt.Value)</p> }
            <p>The camera is used only when you choose an action. Face measurements are computed on your device. STMS stores an encrypted template; no photograph, video or audio is uploaded or stored.</p>
            <div class="face-security-note"><strong>Keep secure device sign-in enabled.</strong><p>Camera matching cannot reliably distinguish a real person from a photo or video. It verifies the template within your signed-in account and does not log you in or replace your password, Windows Hello or passkey.</p></div>
            <label for="face-current-password" class="form-label">Current password</label><input id="face-current-password" type="password" class="form-control" maxlength="256" autocomplete="current-password" data-face-password aria-describedby="face-password-help" /><p class="form-text" id="face-password-help">Required to register, replace or remove your face template.</p>
            <div class="face-actions"><button type="button" class="btn btn-primary" data-face-action="enroll">@(Model.Registered ? "Replace face template" : "Register face")</button>@if (Model.Registered) { <button type="button" class="btn btn-outline-secondary" data-face-action="verify">Verify my face</button><button type="button" class="btn btn-outline-secondary" data-face-action="remove">Remove template</button> }<button type="button" class="btn btn-outline-secondary" data-face-cancel hidden>Cancel camera</button></div>
            <div class="face-capture" data-face-preview hidden><video muted autoplay playsinline aria-label="Live camera preview"></video><div class="face-capture-guide" aria-hidden="true"></div><span>Keep one face in the frame in good lighting.</span></div>
            <p class="face-status" role="status" aria-live="polite" aria-atomic="true" data-face-status>Camera is off. Your browser will request permission before capture.</p>
            <noscript><p>JavaScript is required for camera capture. Device passkey and password settings remain available.</p></noscript>
        </section>
    }
</div>
@section Scripts { @if (Model.Enabled) { <script src="~/js/face-settings.js" asp-append-version="true"></script> } }
